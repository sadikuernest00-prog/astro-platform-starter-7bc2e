---
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>AmicBridge Escrow</title>

    <!-- ETHERS -->
    <script type="module">
      import { ethers } from "https://cdn.jsdelivr.net/npm/ethers@6.13.1/+esm";

      // ESCROW CONTRACT
      const ESCROW_ADDRESS =
        "0x7B6eB10420CdA9Dfcc04AE4964709E19857e7573";

      // BASE USDC
      const USDC_ADDRESS =
        "0x833589fcd6edb6e08f4c7c32d4f71b54bda02913";

      // ABI
      const escrowABI = [
        "function createEscrow(address seller,uint256 amount) external returns (uint256)",
        "function deposit(uint256 escrowId) external",
        "function releaseFunds(uint256 escrowId) external",
        "function refundBuyer(uint256 escrowId) external",
        "function escrowCount() view returns (uint256)",
        "function getEscrow(uint256 escrowId) view returns ((uint256 id,address buyer,address seller,uint256 amount,bool deposited,bool released,bool refunded))"
      ];

      let provider;
      let signer;
      let escrowContract;

      // CONNECT WALLET
      async function connectWallet() {

        try {

          if (!window.ethereum) {
            alert("Install MetaMask");
            return;
          }

          provider = new ethers.BrowserProvider(window.ethereum);

          await provider.send("eth_requestAccounts", []);

          signer = await provider.getSigner();

          escrowContract = new ethers.Contract(
            ESCROW_ADDRESS,
            escrowABI,
            signer
          );

          const address = await signer.getAddress();

          document.getElementById("status").innerText =
            "Connected: " + address;

        } catch (err) {

          console.error(err);

          alert(err.reason || err.message);
        }
      }

      // CREATE ESCROW
      async function createEscrow() {

        try {

          const seller =
            document.getElementById("seller").value;

          const amount =
            document.getElementById("amount").value;

          const parsedAmount =
            ethers.parseUnits(amount, 6);

          const tx =
            await escrowContract.createEscrow(
              seller,
              parsedAmount
            );

          document.getElementById("status").innerText =
            "Creating escrow...";

          await tx.wait();

          const escrowId =
            await escrowContract.escrowCount();

          document.getElementById("escrowId").value =
            escrowId;

          document.getElementById("status").innerText =
            "Escrow created successfully";

          generateQR();
          loadEscrowStatus();

        } catch (err) {

          console.error(err);

          alert(err.reason || err.message);
        }
      }

      // APPROVE USDC
      async function approveUSDC() {

        try {

          const amount =
            document.getElementById("amount").value;

          const parsedAmount =
            ethers.parseUnits(amount, 6);

          const usdcContract = new ethers.Contract(
            USDC_ADDRESS,
            [
              "function approve(address spender,uint256 amount) external returns (bool)"
            ],
            signer
          );

          document.getElementById("status").innerText =
            "Approving USDC...";

          const tx =
            await usdcContract.approve(
              ESCROW_ADDRESS,
              parsedAmount
            );

          await tx.wait();

          document.getElementById("status").innerText =
            "USDC approved successfully";

        } catch (err) {

          console.error(err);

          alert(err.reason || err.message);
        }
      }

      // DEPOSIT
      async function depositUSDC() {

        try {

          const escrowId =
            document.getElementById("escrowId").value;

          const tx =
            await escrowContract.deposit(
              escrowId
            );

          document.getElementById("status").innerText =
            "Depositing USDC...";

          await tx.wait();

          document.getElementById("status").innerText =
            "Funds locked in escrow";

          loadEscrowStatus();

        } catch (err) {

          console.error(err);

          alert(err.reason || err.message);
        }
      }

      // RELEASE
      async function releaseFunds() {

        try {

          const escrowId =
            document.getElementById("escrowId").value;

          const tx =
            await escrowContract.releaseFunds(
              escrowId
            );

          document.getElementById("status").innerText =
            "Releasing funds...";

          await tx.wait();

          document.getElementById("status").innerText =
            "Funds released to seller";

          loadEscrowStatus();

        } catch (err) {

          console.error(err);

          alert(err.reason || err.message);
        }
      }

      // REFUND
      async function refundBuyer() {

        try {

          const escrowId =
            document.getElementById("escrowId").value;

          const tx =
            await escrowContract.refundBuyer(
              escrowId
            );

          document.getElementById("status").innerText =
            "Refunding buyer...";

          await tx.wait();

          document.getElementById("status").innerText =
            "Buyer refunded";

          loadEscrowStatus();

        } catch (err) {

          console.error(err);

          alert(err.reason || err.message);
        }
      }

      // LOAD ESCROW
      async function loadEscrowStatus() {

        try {

          const escrowId =
            document.getElementById("escrowId").value;

          if (!escrowId) return;

          const escrow =
            await escrowContract.getEscrow(
              escrowId
            );

          let status = "CREATED";

          if (escrow.deposited) {
            status = "FUNDED";
          }

          if (
            escrow.deposited &&
            !escrow.released &&
            !escrow.refunded
          ) {
            status = "AWAITING DELIVERY";
          }

          if (escrow.released) {
            status = "RELEASED";
          }

          if (escrow.refunded) {
            status = "REFUNDED";
          }

          const amount =
            ethers.formatUnits(
              escrow.amount,
              6
            );

          document.getElementById("escrowCard").innerHTML = `

            <div class="card">

              <h2>Live Escrow Transaction</h2>

              <div class="line">
                <span>Escrow ID</span>
                <span>#${escrow.id}</span>
              </div>

              <div class="line">
                <span>Status</span>
                <span class="status">${status}</span>
              </div>

              <div class="line">
                <span>Amount</span>
                <span>${amount} USDC</span>
              </div>

              <div class="wallet">
                <label>Buyer Wallet</label>
                <p>${escrow.buyer}</p>
              </div>

              <div class="wallet">
                <label>Seller Wallet</label>
                <p>${escrow.seller}</p>
              </div>

              <div class="proof">
                Funds secured by blockchain smart contract escrow.
              </div>

            </div>

          `;

        } catch (err) {

          console.error(err);
        }
      }

      // GENERATE QR CODE
      function generateQR() {

        const seller =
          document.getElementById("seller").value;

        const amount =
          document.getElementById("amount").value;

        const escrowId =
          document.getElementById("escrowId").value;

        const paymentURL =
          `https://amicbridge.com/pay?escrow=${escrowId}&seller=${seller}&amount=${amount}`;

        document.getElementById("qrCode").innerHTML = `

          <div class="qr-card">

            <h2>Escrow QR Payment</h2>

            <img
              src="https://api.qrserver.com/v1/create-qr-code/?size=260x260&data=${encodeURIComponent(paymentURL)}"
            />

            <p class="qr-text">
              Scan QR to open escrow transaction.
            </p>

            <div class="payment-link">
              ${paymentURL}
            </div>

          </div>

        `;
      }

      window.connectWallet = connectWallet;
      window.createEscrow = createEscrow;
      window.approveUSDC = approveUSDC;
      window.depositUSDC = depositUSDC;
      window.releaseFunds = releaseFunds;
      window.refundBuyer = refundBuyer;
      window.loadEscrowStatus = loadEscrowStatus;
      window.generateQR = generateQR;
    </script>

    <style>

      body {
        background: #000;
        color: white;
        font-family: Arial, sans-serif;
        margin: 0;
        padding: 40px;
      }

      .container {
        max-width: 900px;
        margin: auto;
      }

      h1 {
        text-align: center;
        color: #d4a84f;
        font-size: 64px;
        margin-bottom: 10px;
      }

      .subtitle {
        text-align: center;
        color: #888;
        margin-bottom: 50px;
        font-size: 20px;
      }

      input {
        width: 100%;
        padding: 22px;
        margin-bottom: 18px;
        border-radius: 18px;
        border: 1px solid #333;
        background: #111;
        color: white;
        font-size: 20px;
        box-sizing: border-box;
      }

      .buttons {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 18px;
        margin-top: 20px;
      }

      button {
        padding: 22px;
        border-radius: 18px;
        border: none;
        font-size: 18px;
        font-weight: bold;
        cursor: pointer;
      }

      .gold {
        background: #d4a84f;
        color: black;
      }

      .dark {
        background: #111;
        color: white;
        border: 1px solid #333;
      }

      .green {
        background: #16a34a;
        color: white;
      }

      .red {
        background: #dc2626;
        color: white;
      }

      #status {
        margin-top: 35px;
        text-align: center;
        font-size: 24px;
        color: #00ffae;
        font-weight: bold;
      }

      .card,
      .qr-card {
        margin-top: 40px;
        background: #111;
        border: 1px solid #333;
        border-radius: 24px;
        padding: 35px;
      }

      .card h2,
      .qr-card h2 {
        color: #d4a84f;
        margin-top: 0;
      }

      .line {
        display: flex;
        justify-content: space-between;
        margin-bottom: 18px;
        font-size: 20px;
      }

      .wallet {
        margin-top: 24px;
      }

      .wallet label {
        color: #888;
      }

      .wallet p {
        word-break: break-all;
      }

      .status {
        color: #00ffae;
        font-weight: bold;
      }

      .proof {
        margin-top: 30px;
        padding: 18px;
        background: #0a0a0a;
        border-radius: 16px;
        text-align: center;
        border: 1px solid #222;
        color: #00ffae;
        font-weight: bold;
      }

      .qr-card {
        text-align: center;
      }

      .qr-card img {
        margin-top: 20px;
        border-radius: 20px;
        background: white;
        padding: 12px;
      }

      .qr-text {
        color: #aaa;
        margin-top: 20px;
      }

      .payment-link {
        margin-top: 20px;
        background: #0a0a0a;
        padding: 18px;
        border-radius: 14px;
        border: 1px solid #222;
        word-break: break-all;
        color: #00ffae;
      }

    </style>
  </head>

  <body>

    <div class="container">

      <h1>AmicBridge</h1>

      <div class="subtitle">
        Blockchain escrow infrastructure for global trade settlement.
      </div>

      <input
        id="seller"
        placeholder="Seller Wallet Address"
      />

      <input
        id="amount"
        placeholder="Amount in USDC"
      />

      <input
        id="escrowId"
        placeholder="Escrow ID"
      />

      <div class="buttons">

        <button
          class="gold"
          onclick="connectWallet()"
        >
          Connect Wallet
        </button>

        <button
          class="dark"
          onclick="createEscrow()"
        >
          Create Escrow
        </button>

        <button
          class="dark"
          onclick="approveUSDC()"
        >
          Approve USDC
        </button>

        <button
          class="dark"
          onclick="depositUSDC()"
        >
          Deposit USDC
        </button>

        <button
          class="green"
          onclick="releaseFunds()"
        >
          Release Funds
        </button>

        <button
          class="red"
          onclick="refundBuyer()"
        >
          Refund Buyer
        </button>

        <button
          class="dark"
          onclick="loadEscrowStatus()"
          style="grid-column: span 2;"
        >
          Load Live Escrow
        </button>

      </div>

      <div id="status"></div>

      <div id="escrowCard"></div>

      <div id="qrCode"></div>

    </div>

  </body>
</html>
