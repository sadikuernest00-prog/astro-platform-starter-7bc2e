---
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <title>AmicBridge</title>

    <script type="module">

      import { ethers }
      from "https://cdn.jsdelivr.net/npm/ethers@6.13.1/+esm";

      // =====================================
      // CONTRACTS
      // =====================================

      const ESCROW_ADDRESS =
        "0x6adc89086B4443bE25DaB92c76eE85d0ee36c6c";

      const USDC_ADDRESS =
        "0x833589fcd6edb6e08f4c7c32d4f71b54bda02913";

      // =====================================
      // ABI
      // =====================================

      const escrowABI = [

        "function createEscrow(address seller,uint256 amount) external returns (uint256)",

        "function deposit(uint256 escrowId) external",

        "function releaseFunds(uint256 escrowId) external",

        "function openDispute(uint256 escrowId) external",

        "function escrowCount() view returns (uint256)",

        "function getEscrow(uint256 escrowId) view returns ((uint256 id,address buyer,address seller,uint256 amount,uint256 releaseTime,uint8 status,bool deposited,bool disputed))"

      ];

      let provider;
      let signer;
      let escrowContract;

      // =====================================
      // CONNECT
      // =====================================

      async function connectWallet() {

        try {

          if (!window.ethereum) {
            alert("Install MetaMask");
            return;
          }

          provider =
            new ethers.BrowserProvider(
              window.ethereum
            );

          await provider.send(
            "eth_requestAccounts",
            []
          );

          signer =
            await provider.getSigner();

          escrowContract =
            new ethers.Contract(
              ESCROW_ADDRESS,
              escrowABI,
              signer
            );

          const address =
            await signer.getAddress();

          document.getElementById(
            "status"
          ).innerText =
            "Connected: " + address;

        } catch (err) {

          console.error(err);

          alert(
            err.reason || err.message
          );
        }
      }

      // =====================================
      // CREATE ESCROW
      // =====================================

      async function createEscrow() {

        try {

          const seller =
            document.getElementById(
              "seller"
            ).value;

          const amount =
            document.getElementById(
              "amount"
            ).value;

          if (!seller || !amount) {

            alert(
              "Enter seller and amount"
            );

            return;
          }

          const parsedAmount =
            ethers.parseUnits(
              amount,
              6
            );

          document.getElementById(
            "status"
          ).innerText =
            "Creating escrow...";

          const tx =
            await escrowContract.createEscrow(
              seller,
              parsedAmount
            );

          await tx.wait();

          const escrowId =
            await escrowContract.escrowCount();

          document.getElementById(
            "escrowId"
          ).value = escrowId;

          document.getElementById(
            "status"
          ).innerText =
            "Escrow created successfully";

          loadEscrow();

        } catch (err) {

          console.error(err);

          document.getElementById(
            "status"
          ).innerText =
            "Escrow creation failed";

          alert(
            err.reason || err.message
          );
        }
      }

      // =====================================
      // APPROVE USDC
      // =====================================

      async function approveUSDC() {

        try {

          const amount =
            document.getElementById(
              "amount"
            ).value;

          const parsedAmount =
            ethers.parseUnits(
              amount,
              6
            );

          const usdcContract =
            new ethers.Contract(
              USDC_ADDRESS,
              [
                "function approve(address spender,uint256 amount) external returns (bool)"
              ],
              signer
            );

          document.getElementById(
            "status"
          ).innerText =
            "Approving USDC...";

          const tx =
            await usdcContract.approve(
              ESCROW_ADDRESS,
              parsedAmount
            );

          await tx.wait();

          document.getElementById(
            "status"
          ).innerText =
            "USDC approved successfully";

        } catch (err) {

          console.error(err);

          alert(
            err.reason || err.message
          );
        }
      }

      // =====================================
      // DEPOSIT
      // =====================================

      async function depositUSDC() {

        try {

          const escrowId =
            document.getElementById(
              "escrowId"
            ).value;

          document.getElementById(
            "status"
          ).innerText =
            "Depositing USDC...";

          const tx =
            await escrowContract.deposit(
              escrowId
            );

          await tx.wait();

          document.getElementById(
            "status"
          ).innerText =
            "Funds locked in escrow";

          loadEscrow();

        } catch (err) {

          console.error(err);

          alert(
            err.reason || err.message
          );
        }
      }

      // =====================================
      // RELEASE
      // =====================================

      async function releaseFunds() {

        try {

          const escrowId =
            document.getElementById(
              "escrowId"
            ).value;

          const tx =
            await escrowContract.releaseFunds(
              escrowId
            );

          await tx.wait();

          document.getElementById(
            "status"
          ).innerText =
            "Funds released successfully";

          loadEscrow();

        } catch (err) {

          console.error(err);

          alert(
            err.reason || err.message
          );
        }
      }

      // =====================================
      // DISPUTE
      // =====================================

      async function openDispute() {

        try {

          const escrowId =
            document.getElementById(
              "escrowId"
            ).value;

          const tx =
            await escrowContract.openDispute(
              escrowId
            );

          await tx.wait();

          document.getElementById(
            "status"
          ).innerText =
            "Dispute opened";

          loadEscrow();

        } catch (err) {

          console.error(err);

          alert(
            err.reason || err.message
          );
        }
      }

      // =====================================
      // LOAD ESCROW
      // =====================================

      async function loadEscrow() {

        try {

          const escrowId =
            document.getElementById(
              "escrowId"
            ).value;

          if (!escrowId) return;

          const escrow =
            await escrowContract.getEscrow(
              escrowId
            );

          let status = "CREATED";

          if (Number(escrow.status) === 1)
            status = "FUNDED";

          if (Number(escrow.status) === 2)
            status = "DISPUTED";

          if (Number(escrow.status) === 3)
            status = "RELEASED";

          if (Number(escrow.status) === 4)
            status = "REFUNDED";

          document.getElementById(
            "escrowCard"
          ).innerHTML =
            "<div class='card'>" +

            "<h2>Live Escrow Status</h2>" +

            "<div class='line'>" +
            "<span>Escrow ID</span>" +
            "<span>#" + escrow.id + "</span>" +
            "</div>" +

            "<div class='line'>" +
            "<span>Status</span>" +
            "<span class='status'>" +
            status +
            "</span>" +
            "</div>" +

            "<div class='line'>" +
            "<span>Amount</span>" +
            "<span>" +
            ethers.formatUnits(
              escrow.amount,
              6
            ) +
            " USDC</span>" +
            "</div>" +

            "</div>";

        } catch (err) {

          console.error(err);
        }
      }

      window.connectWallet =
        connectWallet;

      window.createEscrow =
        createEscrow;

      window.approveUSDC =
        approveUSDC;

      window.depositUSDC =
        depositUSDC;

      window.releaseFunds =
        releaseFunds;

      window.openDispute =
        openDispute;

    </script>

    <style>

      body {
        background: black;
        color: white;
        font-family: Arial;
        padding: 40px;
      }

      .container {
        max-width: 900px;
        margin: auto;
      }

      h1 {
        text-align: center;
        color: #d4a84f;
        font-size: 70px;
      }

      input {
        width: 100%;
        padding: 22px;
        margin-bottom: 18px;
        border-radius: 18px;
        border: 1px solid #333;
        background: #111;
        color: white;
        font-size: 20px;
      }

      .buttons {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 18px;
      }

      button {
        padding: 22px;
        border-radius: 18px;
        border: none;
        font-size: 18px;
        font-weight: bold;
        cursor: pointer;
      }

      .gold {
        background: #d4a84f;
        color: black;
      }

      .dark {
        background: #111;
        color: white;
        border: 1px solid #333;
      }

      .green {
        background: #16a34a;
        color: white;
      }

      .red {
        background: #dc2626;
        color: white;
      }

      #status {
        margin-top: 30px;
        text-align: center;
        color: #00ffae;
        font-size: 24px;
        font-weight: bold;
      }

      .card {
        background: #111;
        border: 1px solid #333;
        border-radius: 24px;
        padding: 30px;
        margin-top: 35px;
      }

      .line {
        display: flex;
        justify-content: space-between;
        margin-bottom: 15px;
      }

      .status {
        color: #00ffae;
      }

    </style>

  </head>

  <body>

    <div class="container">

      <h1>
        AmicBridge
      </h1>

      <input
        id="seller"
        placeholder="Seller Wallet Address"
      />

      <input
        id="amount"
        placeholder="Amount in USDC"
      />

      <input
        id="escrowId"
        placeholder="Escrow ID"
      />

      <div class="buttons">

        <button
          class="gold"
          onclick="connectWallet()"
        >
          Connect Wallet
        </button>

        <button
          class="dark"
          onclick="createEscrow()"
        >
          Create Escrow
        </button>

        <button
          class="dark"
          onclick="approveUSDC()"
        >
          Approve USDC
        </button>

        <button
          class="dark"
          onclick="depositUSDC()"
        >
          Deposit USDC
        </button>

        <button
          class="green"
          onclick="releaseFunds()"
        >
          Release Funds
        </button>

        <button
          class="red"
          onclick="openDispute()"
        >
          Open Dispute
        </button>

      </div>

      <div id="status"></div>

      <div id="escrowCard"></div>

    </div>

  </body>
</html>
