---
---

<html lang="en">

<head>

<meta charset="UTF-8" />

<meta
  name="viewport"
  content="width=device-width, initial-scale=1.0"
/>

<title>
AmicBridge Escrow
</title>

<script src="https://cdn.jsdelivr.net/npm/ethers@6.13.1/dist/ethers.umd.min.js"></script>

<style>

*{
  margin:0;
  padding:0;
  box-sizing:border-box;
}

body{
  font-family:Arial,sans-serif;
  background:black;
  color:white;
  overflow-x:hidden;
}

.ticker{
  width:100%;
  background:#0d0d0d;
  border-bottom:1px solid rgba(255,255,255,0.08);
  overflow:hidden;
  white-space:nowrap;
}

.ticker-track{
  display:flex;
  gap:60px;
  padding:14px 0;
  animation:ticker 20s linear infinite;
}

@keyframes ticker{
  0%{
    transform:translateX(0);
  }

  100%{
    transform:translateX(-50%);
  }
}

.ticker-item{
  color:white;
  font-size:15px;
}

.green{
  color:#3ddc84;
  font-weight:bold;
}

.navbar{
  width:100%;
  padding:28px 60px;
  border-bottom:1px solid rgba(255,255,255,0.05);
}

.logo{
  font-size:58px;
  font-weight:900;
}

.logo span{
  color:#d6a85f;
}

.hero{
  min-height:90vh;
  display:flex;
  align-items:center;
  justify-content:center;
  text-align:center;
  padding:40px;
}

.hero-content{
  max-width:1200px;
}

.tag{
  display:inline-block;
  padding:14px 24px;
  border-radius:999px;
  background:rgba(214,168,95,0.1);
  border:1px solid rgba(214,168,95,0.2);
  color:#d6a85f;
  margin-bottom:40px;
  font-weight:bold;
}

h1{
  font-size:96px;
  line-height:1.05;
  margin-bottom:30px;
  font-weight:900;
}

.gold{
  color:#d6a85f;
}

.description{
  color:#999;
  font-size:26px;
  line-height:1.7;
  margin-bottom:50px;
}

.buttons{
  display:flex;
  justify-content:center;
  gap:20px;
  flex-wrap:wrap;
}

button{
  padding:20px 36px;
  border:none;
  border-radius:999px;
  font-size:22px;
  cursor:pointer;
  font-weight:bold;
  transition:0.3s;
}

button:hover{
  transform:translateY(-4px);
}

.connect{
  background:#d6a85f;
  color:black;
}

.deposit{
  background:#111;
  color:white;
  border:1px solid rgba(255,255,255,0.08);
}

.release{
  background:#111;
  color:white;
  border:1px solid rgba(255,255,255,0.08);
}

#status{
  margin-top:40px;
  font-size:22px;
  color:#3ddc84;
}

@media(max-width:900px){

  h1{
    font-size:56px;
  }

  .description{
    font-size:20px;
  }

}

</style>

</head>

<body>

<div class="ticker">

<div class="ticker-track">

<div class="ticker-item">
BTC — $108,220
<span class="green">+4.8%</span>
</div>

<div class="ticker-item">
USDC — $1.00
<span class="green">Stable</span>
</div>

<div class="ticker-item">
BRENT — $82.31
<span class="green">+2.1%</span>
</div>

<div class="ticker-item">
WTI — $79.44
<span class="green">+1.7%</span>
</div>

<div class="ticker-item">
BTC — $108,220
<span class="green">+4.8%</span>
</div>

<div class="ticker-item">
USDC — $1.00
<span class="green">Stable</span>
</div>

</div>

</div>

<nav class="navbar">

<div class="logo">
Amic<span>Bridge</span>
</div>

</nav>

<section class="hero">

<div class="hero-content">

<div class="tag">
GLOBAL CRYPTO COMMODITY INFRASTRUCTURE
</div>

<h1>

Secure Escrow Infrastructure
For International
<span class="gold">
Energy Trade
</span>

</h1>

<p class="description">

AmicBridge provides OTC commodity settlement infrastructure powered by stablecoins,
escrow protection and blockchain-based payments.

</p>

<div class="buttons">

<button
  id="connectButton"
  class="connect"
>
Connect MetaMask
</button>

<button
  id="depositButton"
  class="deposit"
>
Deposit 0.01 ETH
</button>

<button
  id="releaseButton"
  class="release"
>
Release Funds
</button>

</div>

<div id="status"></div>

</div>

</section>

<script>

const contractAddress =
"0x6B4e40CA4A4C86541333aAAEfd360a6CC3885bd";

const abi = [

{
"inputs":[
{
"internalType":"address payable",
"name":"_seller",
"type":"address"
}
],
"stateMutability":"nonpayable",
"type":"constructor"
},

{
"inputs":[],
"name":"deposit",
"outputs":[],
"stateMutability":"payable",
"type":"function"
},

{
"inputs":[],
"name":"releaseFunds",
"outputs":[],
"stateMutability":"nonpayable",
"type":"function"
}

];

const connectButton =
document.getElementById("connectButton");

const depositButton =
document.getElementById("depositButton");

const releaseButton =
document.getElementById("releaseButton");

const status =
document.getElementById("status");

let contract;

async function connectWallet() {

try {

if (typeof window.ethereum === "undefined") {

alert("Please install MetaMask");

return;
}

await window.ethereum.request({
method:"eth_requestAccounts"
});

const provider =
new ethers.BrowserProvider(window.ethereum);

const signer =
await provider.getSigner();

contract =
new ethers.Contract(
contractAddress,
abi,
signer
);

status.innerText =
"MetaMask Connected";

} catch(error) {

console.error(error);

status.innerText =
"Connection Failed";
}

}

async function depositETH() {

try {

if (!contract) {

alert("Connect MetaMask first");

return;
}

const tx =
await contract.deposit({

value:
ethers.parseEther("0.01")

});

status.innerText =
"Waiting for transaction...";

await tx.wait();

status.innerText =
"Deposit Successful";

} catch(error) {

console.error(error);

status.innerText =
"Deposit Failed";
}

}

async function releaseFunds() {

try {

if (!contract) {

alert("Connect MetaMask first");

return;
}

const tx =
await contract.releaseFunds();

status.innerText =
"Releasing funds...";

await tx.wait();

status.innerText =
"Funds Released";

} catch(error) {

console.error(error);

status.innerText =
"Release Failed";
}

}

connectButton.onclick =
connectWallet;

depositButton.onclick =
depositETH;

releaseButton.onclick =
releaseFunds;

</script>

</body>

</html>
