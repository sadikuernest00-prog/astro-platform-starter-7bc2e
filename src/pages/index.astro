---
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <title>AmicBridge</title>

    <script type="module">

      import {
        ethers
      } from "https://cdn.jsdelivr.net/npm/ethers@6.13.1/+esm";

      // =====================================
      // YOUR NEW CONTRACT
      // =====================================

      const ESCROW_ADDRESS =
        "0x3d3f83afF77fB1064ecBA46364CAbf5Db55Dce65";

      // BASE USDC
      const USDC_ADDRESS =
        "0x833589fcd6edb6e08f4c7c32d4f71b54bda02913";

      // =====================================
      // FINAL FIXED ABI
      // =====================================

      const escrowABI = [

        "function createEscrow(address seller,uint256 amount) external returns (uint256)",

        "function deposit(uint256 escrowId) external",

        "function releaseFunds(uint256 escrowId) external",

        "function refundBuyer(uint256 escrowId) external",

        "function escrowCount() view returns (uint256)",

        "function escrows(uint256) view returns (uint256 id,address buyer,address seller,uint256 amount,bool deposited,bool released,bool refunded,uint256 createdAt,uint256 depositedAt,uint256 releasedAt,uint256 refundedAt)"
      ];

      let provider;
      let signer;
      let escrowContract;

      // =====================================
      // CONNECT WALLET
      // =====================================

      async function connectWallet() {

        try {

          if (!window.ethereum) {
            alert("Install MetaMask");
            return;
          }

          provider =
            new ethers.BrowserProvider(
              window.ethereum
            );

          await provider.send(
            "eth_requestAccounts",
            []
          );

          signer =
            await provider.getSigner();

          escrowContract =
            new ethers.Contract(
              ESCROW_ADDRESS,
              escrowABI,
              signer
            );

          const address =
            await signer.getAddress();

          document.getElementById(
            "status"
          ).innerText =
            "Connected: " + address;

        } catch (err) {

          console.error(err);

          alert(err.message);
        }
      }

      // =====================================
      // CREATE ESCROW
      // =====================================

      async function createEscrow() {

        try {

          const seller =
            document.getElementById(
              "seller"
            ).value.trim();

          const amount =
            document.getElementById(
              "amount"
            ).value;

          if (!ethers.isAddress(seller)) {
            alert("Invalid seller address");
            return;
          }

          const parsedAmount =
            ethers.parseUnits(
              amount,
              6
            );

          document.getElementById(
            "status"
          ).innerText =
            "Creating escrow...";

          const tx =
            await escrowContract.createEscrow(
              seller,
              parsedAmount
            );

          await tx.wait();

          const totalEscrows =
            await escrowContract.escrowCount();

          const escrowId =
            Number(totalEscrows) - 1;

          document.getElementById(
            "escrowId"
          ).value =
            escrowId.toString();

          document.getElementById(
            "status"
          ).innerText =
            "Escrow created";

          await loadEscrow();

        } catch (err) {

          console.error(err);

          alert(err.message);
        }
      }

      // =====================================
      // APPROVE USDC
      // =====================================

      async function approveUSDC() {

        try {

          const amount =
            document.getElementById(
              "amount"
            ).value;

          const parsedAmount =
            ethers.parseUnits(
              amount,
              6
            );

          const usdcContract =
            new ethers.Contract(
              USDC_ADDRESS,
              [
                "function approve(address spender,uint256 amount) external returns (bool)"
              ],
              signer
            );

          document.getElementById(
            "status"
          ).innerText =
            "Approving USDC...";

          const tx =
            await usdcContract.approve(
              ESCROW_ADDRESS,
              parsedAmount
            );

          await tx.wait();

          document.getElementById(
            "status"
          ).innerText =
            "USDC approved";

        } catch (err) {

          console.error(err);

          alert(err.message);
        }
      }

      // =====================================
      // DEPOSIT
      // =====================================

      async function depositUSDC() {

        try {

          const escrowId =
            document.getElementById(
              "escrowId"
            ).value;

          document.getElementById(
            "status"
          ).innerText =
            "Depositing USDC...";

          const tx =
            await escrowContract.deposit(
              escrowId
            );

          await tx.wait();

          document.getElementById(
            "status"
          ).innerText =
            "USDC deposited";

          await loadEscrow();

        } catch (err) {

          console.error(err);

          alert(err.message);
        }
      }

      // =====================================
      // RELEASE FUNDS
      // =====================================

      async function releaseFunds() {

        try {

          const escrowId =
            document.getElementById(
              "escrowId"
            ).value;

          document.getElementById(
            "status"
          ).innerText =
            "Releasing funds...";

          const tx =
            await escrowContract.releaseFunds(
              escrowId
            );

          await tx.wait();

          document.getElementById(
            "status"
          ).innerText =
            "Funds released";

          await loadEscrow();

        } catch (err) {

          console.error(err);

          alert(err.message);
        }
      }

      // =====================================
      // REFUND BUYER
      // =====================================

      async function refundBuyer() {

        try {

          const escrowId =
            document.getElementById(
              "escrowId"
            ).value;

          document.getElementById(
            "status"
          ).innerText =
            "Refunding buyer...";

          const tx =
            await escrowContract.refundBuyer(
              escrowId
            );

          await tx.wait();

          document.getElementById(
            "status"
          ).innerText =
            "Buyer refunded";

          await loadEscrow();

        } catch (err) {

          console.error(err);

          alert(err.message);
        }
      }

      // =====================================
      // LOAD ESCROW
      // =====================================

      async function loadEscrow() {

        try {

          const escrowId =
            document.getElementById(
              "escrowId"
            ).value;

          if (!escrowId) return;

          const escrow =
            await escrowContract.escrows(
              escrowId
            );

          let status =
            "CREATED";

          if (escrow.deposited)
            status = "FUNDED";

          if (escrow.released)
            status = "RELEASED";

          if (escrow.refunded)
            status = "REFUNDED";

          const created =
            Number(escrow.createdAt) > 0
              ? new Date(
                  Number(
                    escrow.createdAt
                  ) * 1000
                ).toLocaleString()
              : "-";

          const deposited =
            Number(escrow.depositedAt) > 0
              ? new Date(
                  Number(
                    escrow.depositedAt
                  ) * 1000
                ).toLocaleString()
              : "-";

          const released =
            Number(escrow.releasedAt) > 0
              ? new Date(
                  Number(
                    escrow.releasedAt
                  ) * 1000
                ).toLocaleString()
              : "-";

          const refunded =
            Number(escrow.refundedAt) > 0
              ? new Date(
                  Number(
                    escrow.refundedAt
                  ) * 1000
                ).toLocaleString()
              : "-";

          let shipmentStatus =
            "Waiting Shipment";

          if (escrow.deposited)
            shipmentStatus =
              "In Transit";

          if (escrow.released)
            shipmentStatus =
              "Delivered";

          document.getElementById(
            "escrowCard"
          ).innerHTML =

            `
            <div class="card">

              <h2>
                Live Escrow Transaction
              </h2>

              <div class="line">
                <span>Status</span>
                <span class="status">
                  ${status}
                </span>
              </div>

              <div class="line">
                <span>Buyer</span>
                <span>${escrow.buyer}</span>
              </div>

              <div class="line">
                <span>Seller</span>
                <span>${escrow.seller}</span>
              </div>

              <div class="line">
                <span>Amount</span>
                <span>
                  ${ethers.formatUnits(
                    escrow.amount,
                    6
                  )} USDC
                </span>
              </div>

              <hr>

              <div class="line">
                <span>Created</span>
                <span>${created}</span>
              </div>

              <div class="line">
                <span>Deposited</span>
                <span>${deposited}</span>
              </div>

              <div class="line">
                <span>Released</span>
                <span>${released}</span>
              </div>

              <div class="line">
                <span>Refunded</span>
                <span>${refunded}</span>
              </div>

              <hr>

              <h3 style="color:#d4a84f">
                Shipment Tracking
              </h3>

              <div class="line">
                <span>Shipment Status</span>
                <span>${shipmentStatus}</span>
              </div>

              <div class="line">
                <span>Tracking Number</span>
                <span>AMIC-${escrow.id}</span>
              </div>

              <div class="line">
                <span>Shipment Started</span>
                <span>${deposited}</span>
              </div>

              <div class="line">
                <span>Delivered Time</span>
                <span>${released}</span>
              </div>

            </div>
            `;

        } catch (err) {

          console.error(
            "LOAD ESCROW ERROR:",
            err
          );

          alert(err.message);
        }
      }

      // =====================================
      // AUTO REFRESH
      // =====================================

      setInterval(async () => {

        if (escrowContract) {
          await loadEscrow();
        }

      }, 3000);

      // =====================================
      // GLOBALS
      // =====================================

      window.connectWallet =
        connectWallet;

      window.createEscrow =
        createEscrow;

      window.approveUSDC =
        approveUSDC;

      window.depositUSDC =
        depositUSDC;

      window.releaseFunds =
        releaseFunds;

      window.refundBuyer =
        refundBuyer;

    </script>

    <style>

      body {
        background: black;
        color: white;
        font-family: Arial;
        padding: 40px;
      }

      .container {
        max-width: 900px;
        margin: auto;
      }

      h1 {
        text-align: center;
        color: #d4a84f;
        font-size: 72px;
        margin-bottom: 40px;
      }

      input {
        width: 100%;
        padding: 22px;
        margin-bottom: 18px;
        border-radius: 18px;
        border: 1px solid #333;
        background: #111;
        color: white;
        font-size: 20px;
      }

      .buttons {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 18px;
      }

      button {
        padding: 22px;
        border-radius: 18px;
        border: none;
        font-size: 18px;
        font-weight: bold;
        cursor: pointer;
      }

      .gold {
        background: #d4a84f;
        color: black;
      }

      .dark {
        background: #111;
        color: white;
        border: 1px solid #333;
      }

      .green {
        background: #16a34a;
        color: white;
      }

      .red {
        background: #dc2626;
        color: white;
      }

      #status {
        margin-top: 30px;
        text-align: center;
        color: #00ffae;
        font-size: 24px;
        font-weight: bold;
      }

      .card {
        background: #111;
        border: 1px solid #333;
        border-radius: 24px;
        padding: 30px;
        margin-top: 35px;
      }

      .line {
        display: flex;
        justify-content: space-between;
        margin-bottom: 14px;
        gap: 10px;
        word-break: break-all;
      }

      .status {
        color: #00ffae;
      }

      hr {
        border-color: #333;
        margin: 20px 0;
      }

    </style>

  </head>

  <body>

    <div class="container">

      <h1>AmicBridge</h1>

      <input
        id="seller"
        placeholder="Seller Wallet Address"
      />

      <input
        id="amount"
        placeholder="Amount in USDC"
      />

      <input
        id="escrowId"
        placeholder="Escrow ID"
      />

      <div class="buttons">

        <button
          class="gold"
          onclick="connectWallet()"
        >
          Connect Wallet
        </button>

        <button
          class="dark"
          onclick="createEscrow()"
        >
          Create Escrow
        </button>

        <button
          class="dark"
          onclick="approveUSDC()"
        >
          Approve USDC
        </button>

        <button
          class="dark"
          onclick="depositUSDC()"
        >
          Deposit USDC
        </button>

        <button
          class="green"
          onclick="releaseFunds()"
        >
          Release Funds
        </button>

        <button
          class="red"
          onclick="refundBuyer()"
        >
          Refund Buyer
        </button>

      </div>

      <div id="status"></div>

      <div id="escrowCard"></div>

    </div>

  </body>
</html>
