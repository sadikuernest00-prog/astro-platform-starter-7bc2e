---
---

<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>AmicBridge</title>

  <style>

    *{
      margin:0;
      padding:0;
      box-sizing:border-box;
      font-family:Arial, sans-serif;
    }

    body{
      background:black;
      color:white;
      overflow-x:hidden;
    }

    .ticker{
      width:100%;
      border-bottom:1px solid #222;
      padding:10px;
      color:#4dff88;
      font-size:14px;
      white-space:nowrap;
      overflow:hidden;
    }

    .navbar{
      padding:40px;
      border-bottom:1px solid #111;
    }

    .logo{
      font-size:64px;
      font-weight:800;
    }

    .gold{
      color:#c89b4f;
    }

    .hero{
      min-height:85vh;
      display:flex;
      justify-content:center;
      align-items:center;
      text-align:center;
      padding:40px;
    }

    .hero-content{
      max-width:1300px;
    }

    .badge{
      display:inline-block;
      padding:14px 30px;
      border:1px solid #4a3312;
      border-radius:50px;
      color:#c89b4f;
      background:rgba(200,155,79,0.08);
      margin-bottom:50px;
      font-weight:bold;
    }

    h1{
      font-size:92px;
      line-height:1;
      font-weight:900;
      margin-bottom:40px;
    }

    .subtitle{
      color:#aaa;
      font-size:26px;
      line-height:1.6;
      max-width:1000px;
      margin:auto;
      margin-bottom:60px;
    }

    .buttons{
      display:flex;
      justify-content:center;
      gap:20px;
      flex-wrap:wrap;
    }

    button{
      padding:24px 40px;
      border-radius:50px;
      border:none;
      cursor:pointer;
      font-size:22px;
      font-weight:bold;
      transition:0.3s;
    }

    button:hover{
      transform:scale(1.05);
    }

    .connect{
      background:#c89b4f;
      color:black;
    }

    .deposit,
    .release{
      background:#111;
      color:white;
      border:1px solid #222;
    }

    #status{
      margin-top:40px;
      font-size:22px;
      color:#4dff88;
    }

    @media(max-width:900px){

      h1{
        font-size:56px;
      }

      .logo{
        font-size:40px;
      }

      .subtitle{
        font-size:18px;
      }

    }

  </style>
</head>

<body>

  <div class="ticker">
    BTC — $108,220 +4.8% &nbsp;&nbsp;&nbsp;
    USDC — $1.00 Stable &nbsp;&nbsp;&nbsp;
    BRENT — $82.31 +2.1% &nbsp;&nbsp;&nbsp;
    WTI — $79.44 +1.7%
  </div>

  <div class="navbar">
    <div class="logo">
      Amic<span class="gold">Bridge</span>
    </div>
  </div>

  <section class="hero">

    <div class="hero-content">

      <div class="badge">
        GLOBAL CRYPTO COMMODITY INFRASTRUCTURE
      </div>

      <h1>
        Secure Escrow Infrastructure <br />
        For International <span class="gold">Energy Trade</span>
      </h1>

      <p class="subtitle">
        AmicBridge provides OTC commodity settlement infrastructure powered by stablecoins,
        escrow protection and blockchain-based payments.
      </p>

      <div class="buttons">

        <button id="connectButton" class="connect">
          Connect MetaMask
        </button>

        <button id="depositButton" class="deposit">
          Deposit 0.001 ETH
        </button>

        <button id="releaseButton" class="release">
          Release Funds
        </button>

      </div>

      <div id="status"></div>

    </div>

  </section>

  <script src="https://cdn.jsdelivr.net/npm/ethers@6.13.1/dist/ethers.umd.min.js"></script>

  <script>

    const contractAddress = "0x6B4e40CA4A4C86541333aAAAEfd360a6CC3885bd";

    const abi = [
      {
        "inputs":[
          {
            "internalType":"address payable",
            "name":"_seller",
            "type":"address"
          }
        ],
        "stateMutability":"nonpayable",
        "type":"constructor"
      },
      {
        "inputs":[],
        "name":"deposit",
        "outputs":[],
        "stateMutability":"payable",
        "type":"function"
      },
      {
        "inputs":[],
        "name":"releaseFunds",
        "outputs":[],
        "stateMutability":"nonpayable",
        "type":"function"
      }
    ];

    let provider;
    let signer;
    let contract;

    const connectButton = document.getElementById("connectButton");
    const depositButton = document.getElementById("depositButton");
    const releaseButton = document.getElementById("releaseButton");
    const status = document.getElementById("status");

    connectButton.onclick = async () => {

      try {

        if (!window.ethereum) {
          alert("Please install MetaMask");
          return;
        }

        await window.ethereum.request({
          method: "eth_requestAccounts"
        });

        provider = new ethers.BrowserProvider(window.ethereum);

        signer = await provider.getSigner();

        contract = new ethers.Contract(
          contractAddress,
          abi,
          signer
        );

        status.innerHTML = "✅ MetaMask Connected";

      } catch (error) {

        console.log(error);

        alert("Connection Failed");

      }

    };

    depositButton.onclick = async () => {

      try {

        if (!contract) {
          alert("Connect MetaMask first");
          return;
        }

        const tx = await contract.deposit({
          value: ethers.parseEther("0.001")
        });

        status.innerHTML = "⏳ Deposit Pending...";

        await tx.wait();

        status.innerHTML = "✅ Deposit Successful";

      } catch (error) {

        console.log(error);

        alert("Deposit Failed");

      }

    };

    releaseButton.onclick = async () => {

      try {

        if (!contract) {
          alert("Connect MetaMask first");
          return;
        }

        const tx = await contract.releaseFunds();

        status.innerHTML = "⏳ Releasing Funds...";

        await tx.wait();

        status.innerHTML = "✅ Funds Released";

      } catch (error) {

        console.log(error);

        alert("Release Failed");

      }

    };

  </script>

</body>
</html>
