---
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <title>AmicBridge</title>

    <script type="module">

      import { ethers } from "https://cdn.jsdelivr.net/npm/ethers@6.13.1/+esm";

      // =========================================
      // CONTRACTS
      // =========================================

      const ESCROW_ADDRESS =
        "0x6adc89086B4443bE25DaB92c76eE85d0ee36c6c";

      const USDC_ADDRESS =
        "0x833589fcd6edb6e08f4c7c32d4f71b54bda02913";

      // YOUR NETLIFY DOMAIN
      const WEBSITE_URL =
        "https://paymentinfrastructur.netlify.app";

      // =========================================
      // ABI
      // =========================================

      const escrowABI = [

        "function createEscrow(address seller,uint256 amount) external returns (uint256)",

        "function deposit(uint256 escrowId) external",

        "function releaseFunds(uint256 escrowId) external",

        "function refundBuyer(uint256 escrowId) external",

        "function escrowCount() view returns (uint256)",

        "function getEscrow(uint256 escrowId) view returns ((uint256 id,address buyer,address seller,uint256 amount,bool deposited,bool released,bool refunded))"

      ];

      // =========================================
      // GLOBALS
      // =========================================

      let provider;
      let signer;
      let escrowContract;

      // =========================================
      // CONNECT WALLET
      // =========================================

      async function connectWallet() {

        try {

          if (!window.ethereum) {

            alert("Install MetaMask");
            return;
          }

          provider =
            new ethers.BrowserProvider(
              window.ethereum
            );

          await provider.send(
            "eth_requestAccounts",
            []
          );

          signer =
            await provider.getSigner();

          escrowContract =
            new ethers.Contract(
              ESCROW_ADDRESS,
              escrowABI,
              signer
            );

          const address =
            await signer.getAddress();

          document.getElementById(
            "status"
          ).innerText =
            "Connected: " + address;

        } catch (err) {

          console.error(err);

          alert(
            err.reason || err.message
          );
        }
      }

      // =========================================
      // CREATE ESCROW
      // =========================================

      async function createEscrow() {

        try {

          if (!signer) {

            alert(
              "Connect wallet first"
            );

            return;
          }

          const seller =
            document.getElementById(
              "seller"
            ).value;

          const amount =
            document.getElementById(
              "amount"
            ).value;

          if (!seller || !amount) {

            alert(
              "Enter seller and amount"
            );

            return;
          }

          const parsedAmount =
            ethers.parseUnits(
              amount,
              6
            );

          document.getElementById(
            "status"
          ).innerText =
            "Creating escrow...";

          const tx =
            await escrowContract.createEscrow(
              seller,
              parsedAmount
            );

          await tx.wait();

          const escrowId =
            await escrowContract.escrowCount();

          document.getElementById(
            "escrowId"
          ).value =
            escrowId;

          document.getElementById(
            "status"
          ).innerText =
            "Escrow created successfully";

          generateQR();

          loadEscrowStatus();

        } catch (err) {

          console.error(err);

          document.getElementById(
            "status"
          ).innerText =
            "Escrow creation failed";

          alert(
            err.reason || err.message
          );
        }
      }

      // =========================================
      // APPROVE USDC
      // =========================================

      async function approveUSDC() {

        try {

          if (!signer) {

            alert(
              "Connect wallet first"
            );

            return;
          }

          const amount =
            document.getElementById(
              "amount"
            ).value;

          const parsedAmount =
            ethers.parseUnits(
              amount,
              6
            );

          const usdcContract =
            new ethers.Contract(
              USDC_ADDRESS,
              [
                "function approve(address spender,uint256 amount) external returns (bool)"
              ],
              signer
            );

          document.getElementById(
            "status"
          ).innerText =
            "Approving USDC...";

          const tx =
            await usdcContract.approve(
              ESCROW_ADDRESS,
              parsedAmount
            );

          await tx.wait();

          document.getElementById(
            "status"
          ).innerText =
            "USDC approved successfully";

        } catch (err) {

          console.error(err);

          document.getElementById(
            "status"
          ).innerText =
            "Approval failed";

          alert(
            err.reason || err.message
          );
        }
      }

      // =========================================
      // DEPOSIT USDC
      // =========================================

      async function depositUSDC() {

        try {

          const escrowId =
            document.getElementById(
              "escrowId"
            ).value;

          document.getElementById(
            "status"
          ).innerText =
            "Depositing USDC...";

          const tx =
            await escrowContract.deposit(
              escrowId
            );

          await tx.wait();

          document.getElementById(
            "status"
          ).innerText =
            "Funds locked in escrow";

          loadEscrowStatus();

        } catch (err) {

          console.error(err);

          document.getElementById(
            "status"
          ).innerText =
            "Deposit failed";

          alert(
            err.reason || err.message
          );
        }
      }

      // =========================================
      // RELEASE FUNDS
      // =========================================

      async function releaseFunds() {

        try {

          const escrowId =
            document.getElementById(
              "escrowId"
            ).value;

          document.getElementById(
            "status"
          ).innerText =
            "Releasing funds...";

          const tx =
            await escrowContract.releaseFunds(
              escrowId
            );

          await tx.wait();

          document.getElementById(
            "status"
          ).innerText =
            "Funds released successfully";

          loadEscrowStatus();

        } catch (err) {

          console.error(err);

          document.getElementById(
            "status"
          ).innerText =
            "Release failed";

          alert(
            err.reason || err.message
          );
        }
      }

      // =========================================
      // REFUND BUYER
      // =========================================

      async function refundBuyer() {

        try {

          const escrowId =
            document.getElementById(
              "escrowId"
            ).value;

          document.getElementById(
            "status"
          ).innerText =
            "Refunding buyer...";

          const tx =
            await escrowContract.refundBuyer(
              escrowId
            );

          await tx.wait();

          document.getElementById(
            "status"
          ).innerText =
            "Buyer refunded";

          loadEscrowStatus();

        } catch (err) {

          console.error(err);

          document.getElementById(
            "status"
          ).innerText =
            "Refund failed";

          alert(
            err.reason || err.message
          );
        }
      }

      // =========================================
      // LOAD ESCROW STATUS
      // =========================================

      async function loadEscrowStatus() {

        try {

          const escrowId =
            document.getElementById(
              "escrowId"
            ).value;

          if (!escrowId) return;

          const escrow =
            await escrowContract.getEscrow(
              escrowId
            );

          let status =
            "CREATED";

          if (
            escrow.deposited
          ) {
            status =
              "FUNDED";
          }

          if (
            escrow.deposited &&
            !escrow.released &&
            !escrow.refunded
          ) {
            status =
              "AWAITING DELIVERY";
          }

          if (
            escrow.released
          ) {
            status =
              "RELEASED";
          }

          if (
            escrow.refunded
          ) {
            status =
              "REFUNDED";
          }

          const amount =
            ethers.formatUnits(
              escrow.amount,
              6
            );

          document.getElementById(
            "escrowCard"
          ).innerHTML = `

            <div class="card">

              <h2>
                Live Escrow Transaction
              </h2>

              <div class="line">
                <span>Escrow ID</span>
                <span>#${escrow.id}</span>
              </div>

              <div class="line">
                <span>Status</span>
                <span class="status">
                  ${status}
                </span>
              </div>

              <div class="line">
                <span>Amount</span>
                <span>${amount} USDC</span>
              </div>

              <div class="wallet-box">

                <label>
                  Buyer Wallet
                </label>

                <p>
                  ${escrow.buyer}
                </p>

              </div>

              <div class="wallet-box">

                <label>
                  Seller Wallet
                </label>

                <p>
                  ${escrow.seller}
                </p>

              </div>

              <div class="proof">

                Funds secured by blockchain smart contract escrow.

              </div>

            </div>

          `;

        } catch (err) {

          console.error(err);
        }
      }

      // =========================================
      // GENERATE QR CODE
      // =========================================

      function generateQR() {

        const seller =
          document.getElementById(
            "seller"
          ).value;

        const amount =
          document.getElementById(
            "amount"
          ).value;

        const escrowId =
          document.getElementById(
            "escrowId"
          ).value;

        const paymentURL =

          `${WEBSITE_URL}/pay?escrow=${escrowId}&seller=${seller}&amount=${amount}`;

        document.getElementById(
          "qrCode"
        ).innerHTML = `

          <div class="card qr-card">

            <h2>
              Escrow QR Payment
            </h2>

            <img
              src="https://api.qrserver.com/v1/create-qr-code/?size=280x280&data=${encodeURIComponent(paymentURL)}"
            />

            <div class="payment-link">
              ${paymentURL}
            </div>

            <p class="qr-text">

              Scan this QR code to open the escrow payment page.

            </p>

          </div>

        `;
      }

      // =========================================
      // EXPORT FUNCTIONS
      // =========================================

      window.connectWallet =
        connectWallet;

      window.createEscrow =
        createEscrow;

      window.approveUSDC =
        approveUSDC;

      window.depositUSDC =
        depositUSDC;

      window.releaseFunds =
        releaseFunds;

      window.refundBuyer =
        refundBuyer;

      window.loadEscrowStatus =
        loadEscrowStatus;

    </script>

    <style>

      body {
        background: #000;
        color: white;
        font-family: Arial, sans-serif;
        margin: 0;
        padding: 40px;
      }

      .container {
        max-width: 850px;
        margin: auto;
      }

      h1 {
        text-align: center;
        font-size: 72px;
        color: #d4a84f;
        margin-bottom: 10px;
      }

      .subtitle {
        text-align: center;
        color: #888;
        margin-bottom: 50px;
        font-size: 20px;
      }

      input {
        width: 100%;
        padding: 22px;
        margin-bottom: 18px;
        border-radius: 18px;
        border: 1px solid #333;
        background: #111;
        color: white;
        font-size: 20px;
        box-sizing: border-box;
      }

      .buttons {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 18px;
      }

      button {
        padding: 22px;
        border-radius: 18px;
        border: none;
        font-size: 18px;
        font-weight: bold;
        cursor: pointer;
      }

      .gold {
        background: #d4a84f;
        color: black;
      }

      .dark {
        background: #111;
        color: white;
        border: 1px solid #333;
      }

      .green {
        background: #16a34a;
        color: white;
      }

      .red {
        background: #dc2626;
        color: white;
      }

      #status {
        margin-top: 35px;
        text-align: center;
        color: #00ffae;
        font-size: 26px;
        font-weight: bold;
      }

      .card {
        background: #111;
        border: 1px solid #333;
        border-radius: 24px;
        padding: 35px;
        margin-top: 40px;
      }

      .card h2 {
        color: #d4a84f;
        margin-top: 0;
      }

      .line {
        display: flex;
        justify-content: space-between;
        margin-bottom: 18px;
        font-size: 20px;
      }

      .wallet-box {
        margin-top: 24px;
      }

      .wallet-box label {
        color: #888;
      }

      .wallet-box p {
        word-break: break-all;
      }

      .proof {
        margin-top: 30px;
        padding: 18px;
        border-radius: 14px;
        background: #0a0a0a;
        border: 1px solid #222;
        color: #00ffae;
        text-align: center;
        font-weight: bold;
      }

      .status {
        color: #00ffae;
        font-weight: bold;
      }

      .qr-card {
        text-align: center;
      }

      .qr-card img {
        margin-top: 20px;
        border-radius: 18px;
        background: white;
        padding: 10px;
      }

      .payment-link {
        margin-top: 25px;
        padding: 16px;
        background: #0a0a0a;
        border-radius: 12px;
        border: 1px solid #222;
        word-break: break-all;
        color: #00ffae;
      }

      .qr-text {
        margin-top: 20px;
        color: #888;
      }

    </style>
  </head>

  <body>

    <div class="container">

      <h1>
        AmicBridge
      </h1>

      <div class="subtitle">
        Blockchain escrow infrastructure for global trade settlement.
      </div>

      <input
        id="seller"
        placeholder="Seller Wallet Address"
      />

      <input
        id="amount"
        placeholder="Amount in USDC"
      />

      <input
        id="escrowId"
        placeholder="Escrow ID"
      />

      <div class="buttons">

        <button
          class="gold"
          onclick="connectWallet()"
        >
          Connect Wallet
        </button>

        <button
          class="dark"
          onclick="createEscrow()"
        >
          Create Escrow
        </button>

        <button
          class="dark"
          onclick="approveUSDC()"
        >
          Approve USDC
        </button>

        <button
          class="dark"
          onclick="depositUSDC()"
        >
          Deposit USDC
        </button>

        <button
          class="green"
          onclick="releaseFunds()"
        >
          Release Funds
        </button>

        <button
          class="red"
          onclick="refundBuyer()"
        >
          Refund Buyer
        </button>

      </div>

      <div id="status"></div>

      <div id="escrowCard"></div>

      <div id="qrCode"></div>

    </div>

  </body>
</html>
