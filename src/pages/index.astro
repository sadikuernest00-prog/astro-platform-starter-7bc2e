---
const ESCROW_ADDRESS = "0x7B6eB10420CdA9Dfcc04AE4964709E19857e7573";
---

<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>

  <title>AmicBridge Escrow</title>

  <style>
    *{
      margin:0;
      padding:0;
      box-sizing:border-box;
      font-family:Arial, Helvetica, sans-serif;
    }

    body{
      background:black;
      color:white;
      min-height:100vh;
      display:flex;
      justify-content:center;
      align-items:center;
      overflow-x:hidden;
    }

    .container{
      width:100%;
      max-width:1400px;
      text-align:center;
      padding:40px;
    }

    h1{
      font-size:110px;
      line-height:0.9;
      font-weight:900;
      margin-bottom:40px;
    }

    .gold{
      color:#d4a03a;
    }

    .subtitle{
      color:#8b8b8b;
      font-size:22px;
      max-width:900px;
      margin:auto;
      line-height:1.7;
      margin-bottom:70px;
    }

    .inputs{
      display:flex;
      flex-direction:column;
      align-items:center;
      gap:24px;
      margin-bottom:50px;
    }

    input{
      width:460px;
      height:72px;
      background:#090909;
      border:1px solid #242424;
      border-radius:20px;
      padding:0 24px;
      color:white;
      font-size:28px;
      outline:none;
    }

    input::placeholder{
      color:#777;
    }

    .buttons{
      display:flex;
      justify-content:center;
      align-items:center;
      flex-wrap:wrap;
      gap:18px;
      margin-top:30px;
    }

    button{
      height:72px;
      padding:0 38px;
      border-radius:22px;
      border:none;
      font-size:22px;
      font-weight:700;
      cursor:pointer;
      transition:0.2s;
    }

    button:hover{
      transform:scale(1.03);
    }

    .connect{
      background:#d4a03a;
      color:black;
    }

    .dark{
      background:#0b0b0b;
      color:white;
      border:1px solid #262626;
    }

    .green{
      background:#0bc56d;
      color:white;
    }

    .red{
      background:#e53935;
      color:white;
    }

    #status{
      margin-top:45px;
      color:#00ff99;
      font-size:24px;
      font-weight:700;
    }

    @media(max-width:900px){

      h1{
        font-size:70px;
      }

      input{
        width:100%;
      }

      .buttons{
        flex-direction:column;
      }

      button{
        width:100%;
      }
    }
  </style>
</head>

<body>

<div class="container">

  <h1>
    Secure Escrow <br>
    Infrastructure <span class="gold">For</span><br>
    <span class="gold">International Trade</span>
  </h1>

  <div class="subtitle">
    AmicBridge provides blockchain escrow infrastructure powered by USDC,
    smart contracts and decentralized settlement technology.
  </div>

  <div class="inputs">

    <input
      id="seller"
      placeholder="Seller wallet address"
    />

    <input
      id="amount"
      placeholder="Amount in USDC"
    />

    <input
      id="escrowId"
      placeholder="Escrow Number (1,2,3...)"
    />

  </div>

  <div class="buttons">

    <button
      class="connect"
      onclick="connectWallet()"
    >
      Connect MetaMask
    </button>

    <button
      class="dark"
      onclick="createEscrow()"
    >
      Create Escrow
    </button>

    <button
      class="dark"
      onclick="approveUSDC()"
    >
      Approve USDC
    </button>

    <button
      class="dark"
      onclick="depositUSDC()"
    >
      Deposit USDC
    </button>

    <button
      class="green"
      onclick="releaseFunds()"
    >
      Release Funds
    </button>

    <button
      class="red"
      onclick="refundBuyer()"
    >
      Refund Buyer
    </button>

  </div>

  <div id="status">
    Waiting for wallet connection...
  </div>

</div>

<script type="module">

import { ethers }
from "https://cdn.jsdelivr.net/npm/ethers@6.13.1/+esm";

const ESCROW_ABI = [

  "function createEscrow(address seller, uint256 amount) external returns (uint256)",

  "function deposit(uint256 escrowId) external",

  "function releaseFunds(uint256 escrowId) external",

  "function refundBuyer(uint256 escrowId) external",

  "function escrowCount() view returns (uint256)"
];

const ERC20_ABI = [
  "function approve(address spender, uint256 amount) external returns (bool)"
];

const USDC_ADDRESS =
  "0x833589fCD6EDB6E08f4c7C32D4f71b54bdA02913";

let provider;
let signer;
let escrow;
let usdc;

async function connectWallet(){

  try{

    await window.ethereum.request({
      method:"eth_requestAccounts"
    });

    provider = new ethers.BrowserProvider(window.ethereum);

    signer = await provider.getSigner();

    escrow = new ethers.Contract(
      ESCROW_ADDRESS,
      ESCROW_ABI,
      signer
    );

    usdc = new ethers.Contract(
      USDC_ADDRESS,
      ERC20_ABI,
      signer
    );

    document.getElementById("status").innerText =
      "Wallet connected successfully";

  }catch(err){

    console.error(err);

    document.getElementById("status").innerText =
      "Wallet connection failed";
  }
}

async function createEscrow(){

  try{

    const seller =
      document.getElementById("seller").value;

    const amount =
      document.getElementById("amount").value;

    const tx = await escrow.createEscrow(
      seller,
      ethers.parseUnits(amount, 6)
    );

    document.getElementById("status").innerText =
      "Creating escrow...";

    await tx.wait();

    const escrowId =
      await escrow.escrowCount();

    document.getElementById("escrowId").value =
      escrowId.toString();

    document.getElementById("status").innerText =
      "Escrow created successfully";

  }catch(err){

    console.error(err);

    document.getElementById("status").innerText =
      "Escrow creation failed";
  }
}

async function approveUSDC(){

  try{

    const amount =
      document.getElementById("amount").value;

    const tx = await usdc.approve(
      ESCROW_ADDRESS,
      ethers.parseUnits(amount, 6)
    );

    document.getElementById("status").innerText =
      "Approving USDC...";

    await tx.wait();

    document.getElementById("status").innerText =
      "USDC approved successfully";

  }catch(err){

    console.error(err);

    document.getElementById("status").innerText =
      "USDC approval failed";
  }
}

async function depositUSDC(){

  try{

    const escrowId =
      document.getElementById("escrowId").value;

    const tx = await escrow.deposit(
      escrowId
    );

    document.getElementById("status").innerText =
      "Depositing USDC...";

    await tx.wait();

    document.getElementById("status").innerText =
      "Deposit successful";

  }catch(err){

    console.error(err);

    document.getElementById("status").innerText =
      "Deposit failed";
  }
}

async function releaseFunds(){

  try{

    const escrowId =
      document.getElementById("escrowId").value;

    const tx = await escrow.releaseFunds(
      escrowId
    );

    document.getElementById("status").innerText =
      "Releasing funds...";

    await tx.wait();

    document.getElementById("status").innerText =
      "Funds released";

  }catch(err){

    console.error(err);

    document.getElementById("status").innerText =
      "Release failed";
  }
}

async function refundBuyer(){

  try{

    const escrowId =
      document.getElementById("escrowId").value;

    const tx = await escrow.refundBuyer(
      escrowId
    );

    document.getElementById("status").innerText =
      "Refunding buyer...";

    await tx.wait();

    document.getElementById("status").innerText =
      "Buyer refunded";

  }catch(err){

    console.error(err);

    document.getElementById("status").innerText =
      "Refund failed";
  }
}

window.connectWallet = connectWallet;
window.createEscrow = createEscrow;
window.approveUSDC = approveUSDC;
window.depositUSDC = depositUSDC;
window.releaseFunds = releaseFunds;
window.refundBuyer = refundBuyer;

</script>

</body>
</html>
