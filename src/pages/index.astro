---
---

<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>AmicBridge</title>

  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      font-family: Arial, sans-serif;
    }

    body {
      background: black;
      color: white;
    }

    .topbar {
      width: 100%;
      padding: 10px;
      border-bottom: 1px solid #222;
      overflow: hidden;
      white-space: nowrap;
      color: #55ff99;
      font-size: 14px;
    }

    .navbar {
      padding: 30px 50px;
      border-bottom: 1px solid #111;
    }

    .logo {
      font-size: 60px;
      font-weight: bold;
    }

    .logo span {
      color: #c89b4f;
    }

    .hero {
      min-height: 85vh;
      display: flex;
      justify-content: center;
      align-items: center;
      text-align: center;
      padding: 40px;
    }

    .hero-content {
      max-width: 1200px;
    }

    .badge {
      display: inline-block;
      padding: 12px 25px;
      border: 1px solid #5c3d14;
      border-radius: 50px;
      color: #c89b4f;
      margin-bottom: 40px;
      background: rgba(200,155,79,0.1);
      font-weight: bold;
    }

    h1 {
      font-size: 90px;
      line-height: 1;
      font-weight: 800;
      margin-bottom: 40px;
    }

    .gold {
      color: #c89b4f;
    }

    .subtitle {
      color: #aaa;
      font-size: 24px;
      line-height: 1.6;
      margin-bottom: 50px;
    }

    .buttons {
      display: flex;
      justify-content: center;
      gap: 20px;
      flex-wrap: wrap;
    }

    button {
      padding: 22px 40px;
      border-radius: 50px;
      border: none;
      font-size: 22px;
      font-weight: bold;
      cursor: pointer;
      transition: 0.3s;
    }

    .connect {
      background: #c89b4f;
      color: black;
    }

    .deposit,
    .release {
      background: #111;
      color: white;
      border: 1px solid #222;
    }

    button:hover {
      transform: scale(1.05);
    }

    #status {
      margin-top: 40px;
      color: #55ff99;
      font-size: 22px;
    }

    @media(max-width:900px){
      h1{
        font-size:55px;
      }

      .logo{
        font-size:40px;
      }

      .subtitle{
        font-size:18px;
      }
    }
  </style>
</head>

<body>

  <div class="topbar">
    BTC — $108,220 +4.8% &nbsp;&nbsp;&nbsp;
    USDC — $1.00 Stable &nbsp;&nbsp;&nbsp;
    BRENT — $82.31 +2.1% &nbsp;&nbsp;&nbsp;
    WTI — $79.44 +1.7%
  </div>

  <div class="navbar">
    <div class="logo">
      Amic<span>Bridge</span>
    </div>
  </div>

  <section class="hero">
    <div class="hero-content">

      <div class="badge">
        GLOBAL CRYPTO COMMODITY INFRASTRUCTURE
      </div>

      <h1>
        Secure Escrow Infrastructure <br />
        For International <span class="gold">Energy Trade</span>
      </h1>

      <p class="subtitle">
        AmicBridge provides OTC commodity settlement infrastructure
        powered by stablecoins, escrow protection and blockchain-based payments.
      </p>

      <div class="buttons">

        <button id="connectButton" class="connect">
          Connect MetaMask
        </button>

        <button id="depositButton" class="deposit">
          Deposit 0.001 ETH
        </button>

        <button id="releaseButton" class="release">
          Release Funds
        </button>

      </div>

      <div id="status"></div>

    </div>
  </section>

  <script type="module">

    import { ethers } from "ethers";

    const contractAddress = "0x6B4e40CA4A4C86541333aAAAEfd360a6CC3885bd";

    const abi = [
      {
        "inputs":[
          {
            "internalType":"address payable",
            "name":"_seller",
            "type":"address"
          }
        ],
        "stateMutability":"nonpayable",
        "type":"constructor"
      },
      {
        "inputs":[],
        "name":"deposit",
        "outputs":[],
        "stateMutability":"payable",
        "type":"function"
      },
      {
        "inputs":[],
        "name":"releaseFunds",
        "outputs":[],
        "stateMutability":"nonpayable",
        "type":"function"
      }
    ];

    let provider;
    let signer;
    let contract;

    const connectButton = document.getElementById("connectButton");
    const depositButton = document.getElementById("depositButton");
    const releaseButton = document.getElementById("releaseButton");
    const status = document.getElementById("status");

    connectButton.addEventListener("click", async () => {

      try {

        if (!window.ethereum) {
          alert("Please install MetaMask");
          return;
        }

        await window.ethereum.request({
          method: "eth_requestAccounts",
        });

        provider = new ethers.BrowserProvider(window.ethereum);

        signer = await provider.getSigner();

        contract = new ethers.Contract(
          contractAddress,
          abi,
          signer
        );

        status.innerHTML = "✅ MetaMask Connected";

      } catch (error) {
        console.log(error);
        alert("Connection failed");
      }

    });

    depositButton.addEventListener("click", async () => {

      try {

        if (!contract) {
          alert("Connect MetaMask first");
          return;
        }

        const tx = await contract.deposit({
          value: ethers.parseEther("0.001")
        });

        status.innerHTML = "⏳ Waiting for deposit confirmation...";

        await tx.wait();

        status.innerHTML = "✅ Deposit Successful";

      } catch (error) {
        console.log(error);
        alert("Deposit failed");
      }

    });

    releaseButton.addEventListener("click", async () => {

      try {

        if (!contract) {
          alert("Connect MetaMask first");
          return;
        }

        const tx = await contract.releaseFunds();

        status.innerHTML = "⏳ Releasing funds...";

        await tx.wait();

        status.innerHTML = "✅ Funds Released";

      } catch (error) {
        console.log(error);
        alert("Release failed");
      }

    });

  </script>

</body>
</html>
