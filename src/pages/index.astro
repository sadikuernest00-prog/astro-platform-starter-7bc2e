---
---

<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>

  <title>AmicBridge Escrow</title>

  <style>

    *{
      margin:0;
      padding:0;
      box-sizing:border-box;
      font-family:Arial, sans-serif;
    }

    body{
      background:black;
      color:white;
      min-height:100vh;
      display:flex;
      flex-direction:column;
      align-items:center;
      justify-content:center;
      padding:40px;
    }

    h1{
      font-size:90px;
      text-align:center;
      line-height:1;
      font-weight:900;
    }

    .gold{
      color:#d6a548;
    }

    p{
      margin-top:40px;
      color:#8d8d8d;
      text-align:center;
      font-size:22px;
      max-width:1000px;
      line-height:1.5;
    }

    .form{
      margin-top:60px;
      display:flex;
      flex-direction:column;
      gap:24px;
      width:460px;
    }

    input{
      background:#0b0b0b;
      border:2px solid #222;
      border-radius:20px;
      padding:24px;
      color:white;
      font-size:20px;
      width:100%;
    }

    .buttons{
      margin-top:40px;
      display:flex;
      flex-wrap:wrap;
      justify-content:center;
      gap:20px;
    }

    button{
      border:none;
      border-radius:24px;
      padding:24px 38px;
      font-size:22px;
      font-weight:700;
      cursor:pointer;
      color:white;
      background:#0b0b0b;
      border:2px solid #222;
      transition:0.2s;
    }

    button:hover{
      transform:scale(1.03);
    }

    .connect{
      background:#d6a548;
      color:black;
    }

    .release{
      background:#16c96b;
    }

    .refund{
      background:#ef3737;
    }

    #status{
      margin-top:40px;
      color:#00ffb3;
      font-size:22px;
      font-weight:bold;
      text-align:center;
    }

    .card{
      margin-top:80px;
      width:700px;
      background:black;
    }

    .card h2{
      font-size:60px;
      margin-bottom:30px;
    }

    .card h3{
      font-size:44px;
      margin-bottom:30px;
    }

    .card p{
      text-align:left;
      margin-top:25px;
      color:white;
      font-size:30px;
    }

  </style>

</head>

<body>

  <h1>
    Secure Escrow<br/>
    Infrastructure
    <span class="gold">For</span><br/>
    <span class="gold">International Trade</span>
  </h1>

  <p>
    AmicBridge provides blockchain escrow infrastructure powered by USDC,
    smart contracts and decentralized settlement technology.
  </p>

  <div class="form">

    <input
      id="seller"
      placeholder="Seller wallet address"
    />

    <input
      id="amount"
      placeholder="Amount in USDC"
    />

    <input
      id="escrowId"
      placeholder="Escrow Number (1,2,3...)"
    />

  </div>

  <div class="buttons">

    <button
      class="connect"
      onclick="connectWallet()"
    >
      Connect MetaMask
    </button>

    <button
      onclick="createEscrow()"
    >
      Create Escrow
    </button>

    <button
      onclick="approveUSDC()"
    >
      Approve USDC
    </button>

    <button
      onclick="depositUSDC()"
    >
      Deposit USDC
    </button>

    <button
      class="release"
      onclick="releaseFunds()"
    >
      Release Funds
    </button>

    <button
      class="refund"
      onclick="refundBuyer()"
    >
      Refund Buyer
    </button>

  </div>

  <div id="status">
    Waiting for wallet connection...
  </div>

  <div
    id="escrowCard"
    class="card"
    style="display:none;"
  >

    <h2>Active Escrows</h2>

    <h3 id="escrowTitle">
      Escrow #1
    </h3>

    <p id="escrowSeller"></p>

    <p id="escrowAmount"></p>

    <p id="escrowStatus"></p>

  </div>

<script type="module">

import { ethers }
from "https://cdn.jsdelivr.net/npm/ethers@6.13.1/+esm";

const ESCROW_ADDRESS =
"0x7B6eB10420CdA9Dfcc04AE4964709E19857e7573";

const USDC_ADDRESS =
"0x833589fCD6EDB6E08f4c7C32D4f71b54bdA02913";

const ESCROW_ABI = [

"function createEscrow(address seller, uint256 amount) external returns (uint256)",

"function deposit(uint256 escrowId) external",

"function releaseFunds(uint256 escrowId) external",

"function refundBuyer(uint256 escrowId) external",

"function escrowCount() view returns (uint256)"

];

const ERC20_ABI = [

"function approve(address spender, uint256 amount) external returns (bool)"

];

let provider;
let signer;
let escrow;
let usdc;

async function connectWallet() {

try {

if (!window.ethereum) {

alert("MetaMask not installed");
return;
}

await window.ethereum.request({
method:"eth_requestAccounts"
});

provider =
new ethers.BrowserProvider(window.ethereum);

signer =
await provider.getSigner();

escrow =
new ethers.Contract(
ESCROW_ADDRESS,
ESCROW_ABI,
signer
);

usdc =
new ethers.Contract(
USDC_ADDRESS,
ERC20_ABI,
signer
);

const address =
await signer.getAddress();

document.getElementById("status").innerText =
"Connected: " + address;

} catch(err){

console.error(err);

document.getElementById("status").innerText =
"Wallet connection failed";

}

}

async function createEscrow(){

try{

const seller =
document.getElementById("seller").value;

const amount =
document.getElementById("amount").value;

const tx =
await escrow.createEscrow(
seller,
ethers.parseUnits(amount,6)
);

document.getElementById("status").innerText =
"Creating escrow...";

await tx.wait();

const escrowId =
await escrow.escrowCount();

document.getElementById("escrowId").value =
escrowId.toString();

document.getElementById("escrowCard").style.display =
"block";

document.getElementById("escrowTitle").innerText =
`Escrow #${escrowId}`;

document.getElementById("escrowSeller").innerText =
`Seller: ${seller}`;

document.getElementById("escrowAmount").innerText =
`Amount: ${amount} USDC`;

document.getElementById("escrowStatus").innerText =
"Status: AWAITING PAYMENT";

document.getElementById("status").innerText =
"Escrow created successfully";

}catch(err){

console.error(err);

document.getElementById("status").innerText =
"Escrow creation failed";

}

}

async function approveUSDC(){

try{

const amount =
document.getElementById("amount").value;

const tx =
await usdc.approve(
ESCROW_ADDRESS,
ethers.parseUnits(amount,6)
);

document.getElementById("status").innerText =
"Approving USDC...";

await tx.wait();

document.getElementById("status").innerText =
"USDC approved";

}catch(err){

console.error(err);

document.getElementById("status").innerText =
"USDC approval failed";

}

}

async function depositUSDC(){

try{

const escrowId =
document.getElementById("escrowId").value;

const tx =
await escrow.deposit(escrowId);

document.getElementById("status").innerText =
"Depositing USDC...";

await tx.wait();

document.getElementById("escrowStatus").innerText =
"Status: PAYMENT SECURED";

document.getElementById("status").innerText =
"Deposit successful";

}catch(err){

console.error(err);

document.getElementById("status").innerText =
"Deposit failed";

}

}

async function releaseFunds(){

try{

const escrowId =
document.getElementById("escrowId").value;

const tx =
await escrow.releaseFunds(escrowId);

document.getElementById("status").innerText =
"Releasing funds...";

await tx.wait();

document.getElementById("escrowStatus").innerText =
"Status: FUNDS RELEASED";

document.getElementById("status").innerText =
"Funds released";

}catch(err){

console.error(err);

document.getElementById("status").innerText =
"Release failed";

}

}

async function refundBuyer(){

try{

const escrowId =
document.getElementById("escrowId").value;

const tx =
await escrow.refundBuyer(escrowId);

document.getElementById("status").innerText =
"Refunding buyer...";

await tx.wait();

document.getElementById("escrowStatus").innerText =
"Status: BUYER REFUNDED";

document.getElementById("status").innerText =
"Buyer refunded";

}catch(err){

console.error(err);

document.getElementById("status").innerText =
"Refund failed";

}

}

window.connectWallet =
connectWallet;

window.createEscrow =
createEscrow;

window.approveUSDC =
approveUSDC;

window.depositUSDC =
depositUSDC;

window.releaseFunds =
releaseFunds;

window.refundBuyer =
refundBuyer;

</script>

</body>
</html>
