---
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>AmicBridge Escrow</title>

    <script type="module">
      import { ethers } from "https://cdn.jsdelivr.net/npm/ethers@6.13.1/+esm";

      // YOUR DEPLOYED ESCROW CONTRACT
      const ESCROW_ADDRESS = "0x7B6eB10420CdA9Dfcc04AE4964709E19857e7573";

      // BASE MAINNET USDC
      const USDC_ADDRESS = "0x833589fCD6EDB6E08f4c7C32D4f71b54bdA02913";

      // ESCROW ABI
      const escrowABI = [
        "function createEscrow(address seller,uint256 amount,string memory item) public",
        "function deposit(uint256 escrowId) public",
        "function release(uint256 escrowId) public",
        "function refund(uint256 escrowId) public"
      ];

      // USDC ABI
      const usdcABI = [
        "function approve(address spender,uint256 amount) public returns (bool)"
      ];

      let provider;
      let signer;
      let escrowContract;

      // CONNECT WALLET
      async function connectWallet() {
        try {
          if (!window.ethereum) {
            alert("Install MetaMask");
            return;
          }

          provider = new ethers.BrowserProvider(window.ethereum);

          await provider.send("eth_requestAccounts", []);

          signer = await provider.getSigner();

          escrowContract = new ethers.Contract(
            ESCROW_ADDRESS,
            escrowABI,
            signer
          );

          document.getElementById("status").innerText =
            "Wallet connected";
        } catch (err) {
          console.error(err);
          document.getElementById("status").innerText =
            "Connection failed";
        }
      }

      // CREATE ESCROW
      async function createEscrow() {
        try {
          const seller =
            document.getElementById("seller").value;

          const amount =
            document.getElementById("amount").value;

          const item =
            document.getElementById("item").value;

          const parsedAmount =
            ethers.parseUnits(amount, 6);

          const tx =
            await escrowContract.createEscrow(
              seller,
              parsedAmount,
              item
            );

          document.getElementById("status").innerText =
            "Creating escrow...";

          await tx.wait();

          document.getElementById("status").innerText =
            "Escrow created successfully";
        } catch (err) {
          console.error(err);

          document.getElementById("status").innerText =
            "Escrow creation failed";
        }
      }

      // APPROVE USDC
      async function approveUSDC() {
        try {
          const amount =
            document.getElementById("amount").value;

          const usdcContract = new ethers.Contract(
            USDC_ADDRESS,
            usdcABI,
            signer
          );

          const parsedAmount =
            ethers.parseUnits(amount, 6);

          const tx =
            await usdcContract.approve(
              ESCROW_ADDRESS,
              parsedAmount
            );

          document.getElementById("status").innerText =
            "Approving USDC...";

          await tx.wait();

          document.getElementById("status").innerText =
            "USDC approved successfully";
        } catch (err) {
          console.error(err);

          document.getElementById("status").innerText =
            "USDC approval failed";
        }
      }

      // DEPOSIT
      async function depositUSDC() {
        try {
          const escrowId =
            document.getElementById("escrowId").value;

          const tx =
            await escrowContract.deposit(escrowId);

          document.getElementById("status").innerText =
            "Depositing USDC...";

          await tx.wait();

          document.getElementById("status").innerText =
            "Deposit successful";
        } catch (err) {
          console.error(err);

          document.getElementById("status").innerText =
            "Deposit failed";
        }
      }

      // RELEASE FUNDS
      async function releaseFunds() {
        try {
          const escrowId =
            document.getElementById("escrowId").value;

          const tx =
            await escrowContract.release(escrowId);

          document.getElementById("status").innerText =
            "Releasing funds...";

          await tx.wait();

          document.getElementById("status").innerText =
            "Funds released";
        } catch (err) {
          console.error(err);

          document.getElementById("status").innerText =
            "Release failed";
        }
      }

      // REFUND
      async function refundBuyer() {
        try {
          const escrowId =
            document.getElementById("escrowId").value;

          const tx =
            await escrowContract.refund(escrowId);

          document.getElementById("status").innerText =
            "Refunding buyer...";

          await tx.wait();

          document.getElementById("status").innerText =
            "Buyer refunded";
        } catch (err) {
          console.error(err);

          document.getElementById("status").innerText =
            "Refund failed";
        }
      }

      window.connectWallet = connectWallet;
      window.createEscrow = createEscrow;
      window.approveUSDC = approveUSDC;
      window.depositUSDC = depositUSDC;
      window.releaseFunds = releaseFunds;
      window.refundBuyer = refundBuyer;
    </script>

    <style>
      body {
        background: black;
        color: white;
        font-family: Arial;
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: 100vh;
      }

      .container {
        width: 700px;
        text-align: center;
      }

      h1 {
        font-size: 60px;
        color: #d4a84f;
      }

      p {
        color: gray;
        margin-bottom: 40px;
      }

      input {
        width: 100%;
        padding: 25px;
        margin-bottom: 20px;
        border-radius: 20px;
        border: 1px solid #333;
        background: black;
        color: white;
        font-size: 28px;
      }

      .buttons {
        display: flex;
        flex-wrap: wrap;
        gap: 20px;
        justify-content: center;
      }

      button {
        padding: 22px 40px;
        border-radius: 20px;
        border: none;
        font-size: 22px;
        font-weight: bold;
        cursor: pointer;
      }

      .gold {
        background: #d4a84f;
        color: black;
      }

      .green {
        background: #22c55e;
        color: white;
      }

      .red {
        background: #ef4444;
        color: white;
      }

      .dark {
        background: #111;
        color: white;
        border: 1px solid #333;
      }

      #status {
        margin-top: 40px;
        font-size: 32px;
        color: #00ffae;
        font-weight: bold;
      }
    </style>
  </head>

  <body>
    <div class="container">
      <h1>International Trade</h1>

      <p>
        AmicBridge provides blockchain escrow infrastructure powered by USDC,
        smart contracts and decentralized settlement technology.
      </p>

      <input
        id="seller"
        placeholder="Seller Wallet Address"
      />

      <input
        id="amount"
        placeholder="Amount in USDC"
      />

      <input
        id="item"
        placeholder="Item Name"
      />

      <input
        id="escrowId"
        placeholder="Escrow ID"
      />

      <div class="buttons">
        <button
          class="gold"
          onclick="connectWallet()"
        >
          Connect MetaMask
        </button>

        <button
          class="dark"
          onclick="createEscrow()"
        >
          Create Escrow
        </button>

        <button
          class="dark"
          onclick="approveUSDC()"
        >
          Approve USDC
        </button>

        <button
          class="dark"
          onclick="depositUSDC()"
        >
          Deposit USDC
        </button>

        <button
          class="green"
          onclick="releaseFunds()"
        >
          Release Funds
        </button>

        <button
          class="red"
          onclick="refundBuyer()"
        >
          Refund Buyer
        </button>
      </div>

      <div id="status"></div>
    </div>
  </body>
</html>
