---
import { ethers } from "ethers";

const CONTRACT_ADDRESS =
  "0xABD89d64ece71a87C6F3d20DE038930D8f99B02E";

const CONTRACT_ABI = [
  "function createEscrow(address seller,uint256 amount)",
  "function deposit(uint256 escrowId)",
  "function releaseFunds(uint256 escrowId)",
  "function refundBuyer(uint256 escrowId)",
  "function openDispute(uint256 escrowId)",
  "function getEscrow(uint256 escrowId) view returns(tuple(uint256 id,address buyer,address seller,uint256 amount,uint8 state,bool exists))"
];
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <title>AmicBridge Escrow</title>

    <style>
      body {
        margin: 0;
        font-family: Arial;
        background: #000;
        color: white;
      }

      .container {
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        padding: 40px;
      }

      h1 {
        font-size: 72px;
        text-align: center;
        max-width: 1000px;
        line-height: 1.1;
      }

      .gold {
        color: #d4a24c;
      }

      p {
        color: #999;
        max-width: 700px;
        text-align: center;
        font-size: 20px;
        line-height: 1.6;
      }

      .buttons {
        display: flex;
        gap: 20px;
        margin-top: 40px;
        flex-wrap: wrap;
      }

      button {
        background: #111;
        border: 1px solid #333;
        color: white;
        padding: 18px 30px;
        border-radius: 14px;
        font-size: 18px;
        cursor: pointer;
      }

      button:hover {
        opacity: 0.8;
      }

      .primary {
        background: #d4a24c;
        color: black;
        font-weight: bold;
      }

      .status {
        margin-top: 30px;
        color: #00ff99;
        font-size: 18px;
      }

      input {
        width: 300px;
        padding: 14px;
        border-radius: 10px;
        border: 1px solid #333;
        background: #111;
        color: white;
        margin-top: 10px;
      }

      .form {
        display: flex;
        flex-direction: column;
        gap: 10px;
        margin-top: 30px;
      }
    </style>
  </head>

  <body>
    <div class="container">

      <div
        style="
          border:1px solid #333;
          padding:10px 20px;
          border-radius:999px;
          margin-bottom:40px;
          color:#d4a24c;
        "
      >
        GLOBAL CRYPTO COMMODITY INFRASTRUCTURE
      </div>

      <h1>
        Secure Escrow Infrastructure
        <span class="gold">
          For International Trade
        </span>
      </h1>

      <p>
        AmicBridge provides blockchain escrow
        infrastructure powered by USDC,
        smart contracts and decentralized
        settlement technology.
      </p>

      <div class="form">

        <input
          id="seller"
          placeholder="Seller wallet address"
        />

        <input
          id="amount"
          placeholder="Amount in USDC"
        />

      </div>

      <div class="buttons">

        <button
          class="primary"
          id="connectBtn"
        >
          Connect MetaMask
        </button>

        <button id="createBtn">
          Create Escrow
        </button>

        <button id="releaseBtn">
          Release Funds
        </button>

      </div>

      <div
        id="status"
        class="status"
      >
        Waiting for wallet connection...
      </div>

    </div>

    <script type="module">

      import { ethers }
      from "https://cdn.jsdelivr.net/npm/ethers@5.7.2/dist/ethers.esm.min.js";

      const CONTRACT_ADDRESS =
        "0xABD89d64ece71a87C6F3d20DE038930D8f99B02E";

      const CONTRACT_ABI = [
        "function createEscrow(address seller,uint256 amount)",
        "function releaseFunds(uint256 escrowId)"
      ];

      let provider;
      let signer;
      let contract;

      const status =
        document.getElementById("status");

      async function connectWallet() {

        if (!window.ethereum) {
          alert("Install MetaMask");
          return;
        }

        await window.ethereum.request({
          method: "eth_requestAccounts"
        });

        provider =
          new ethers.providers.Web3Provider(
            window.ethereum
          );

        signer = provider.getSigner();

        contract =
          new ethers.Contract(
            CONTRACT_ADDRESS,
            CONTRACT_ABI,
            signer
          );

        const address =
          await signer.getAddress();

        status.innerHTML =
          "Connected: " + address;
      }

      async function createEscrow() {

        if (!contract) {
          alert("Connect wallet first");
          return;
        }

        const seller =
          document.getElementById("seller").value;

        const amount =
          document.getElementById("amount").value;

        const parsedAmount =
          ethers.utils.parseUnits(
            amount,
            6
          );

        status.innerHTML =
          "Creating escrow...";

        try {

          const tx =
            await contract.createEscrow(
              seller,
              parsedAmount
            );

          await tx.wait();

          status.innerHTML =
            "Escrow created successfully!";

        } catch (err) {

          console.error(err);

          status.innerHTML =
            "Transaction failed";

        }
      }

      async function releaseFunds() {

        if (!contract) {
          alert("Connect wallet first");
          return;
        }

        try {

          status.innerHTML =
            "Releasing funds...";

          const tx =
            await contract.releaseFunds(1);

          await tx.wait();

          status.innerHTML =
            "Funds released successfully!";

        } catch (err) {

          console.error(err);

          status.innerHTML =
            "Release failed";

        }
      }

      document
        .getElementById("connectBtn")
        .addEventListener(
          "click",
          connectWallet
        );

      document
        .getElementById("createBtn")
        .addEventListener(
          "click",
          createEscrow
        );

      document
        .getElementById("releaseBtn")
        .addEventListener(
          "click",
          releaseFunds
        );

    </script>
  </body>
</html>
