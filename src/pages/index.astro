---
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <title>AmicBridge Escrow</title>

    <style>

      body {
        margin: 0;
        background: black;
        color: white;
        font-family: Arial, sans-serif;
      }

      .container {
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        padding: 40px;
      }

      h1 {
        font-size: 72px;
        text-align: center;
        line-height: 1;
        max-width: 1000px;
      }

      .gold {
        color: #d4a24c;
      }

      p {
        color: #888;
        text-align: center;
        max-width: 800px;
        font-size: 22px;
        line-height: 1.5;
      }

      .form {
        display: flex;
        flex-direction: column;
        gap: 20px;
        margin-top: 40px;
      }

      input {
        width: 360px;
        padding: 18px;
        border-radius: 14px;
        border: 1px solid #333;
        background: #111;
        color: white;
        font-size: 16px;
      }

      .buttons {
        display: flex;
        gap: 20px;
        margin-top: 40px;
        flex-wrap: wrap;
        justify-content: center;
      }

      button {
        padding: 18px 30px;
        border-radius: 16px;
        border: 1px solid #333;
        background: #111;
        color: white;
        font-size: 20px;
        cursor: pointer;
      }

      .primary {
        background: #d4a24c;
        color: black;
        font-weight: bold;
      }

      .status {
        margin-top: 40px;
        color: #00ff99;
        font-size: 22px;
      }

    </style>
  </head>

  <body>

    <div class="container">

      <h1>
        Secure Escrow Infrastructure
        <span class="gold">
          For International Trade
        </span>
      </h1>

      <p>
        AmicBridge provides blockchain escrow
        infrastructure powered by USDC,
        smart contracts and decentralized
        settlement technology.
      </p>

      <div class="form">

        <input
          id="seller"
          placeholder="Seller wallet address"
        />

        <input
          id="amount"
          placeholder="Amount in USDC"
        />

        <input
          id="escrowId"
          placeholder="Escrow ID"
        />

      </div>

      <div class="buttons">

        <button
          id="connectBtn"
          class="primary"
        >
          Connect MetaMask
        </button>

        <button id="createBtn">
          Create Escrow
        </button>

        <button id="approveBtn">
          Approve USDC
        </button>

        <button id="depositBtn">
          Deposit USDC
        </button>

      </div>

      <div
        id="status"
        class="status"
      >
        Waiting for wallet connection...
      </div>

    </div>

    <script is:inline type="module">

      import {
        ethers
      } from "https://cdn.jsdelivr.net/npm/ethers@5.7.2/dist/ethers.esm.min.js";

      // LIVE ESCROW CONTRACT
      const ESCROW_ADDRESS =
        "0xABD89d64ece71a87C6F3d20DE038930D8f99B02E";

      // BASE USDC
      const USDC_ADDRESS =
        "0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913";

      // ESCROW ABI
      const ESCROW_ABI = [

        "function createEscrow(address seller,uint256 amount)",

        "function deposit(uint256 escrowId)"

      ];

      // USDC ABI
      const USDC_ABI = [

        "function approve(address spender,uint256 amount) public returns (bool)"

      ];

      let provider;
      let signer;
      let escrowContract;
      let usdcContract;

      const status =
        document.getElementById("status");

      async function connectWallet() {

        try {

          if (!window.ethereum) {

            alert(
              "Install MetaMask"
            );

            return;
          }

          await window.ethereum.request({

            method:
              "eth_requestAccounts"

          });

          provider =
            new ethers.providers.Web3Provider(
              window.ethereum
            );

          signer =
            provider.getSigner();

          escrowContract =
            new ethers.Contract(

              ESCROW_ADDRESS,

              ESCROW_ABI,

              signer

            );

          usdcContract =
            new ethers.Contract(

              USDC_ADDRESS,

              USDC_ABI,

              signer

            );

          const address =
            await signer.getAddress();

          status.innerHTML =
            "Connected: " + address;

        } catch (err) {

          console.error(err);

          status.innerHTML =
            "Wallet connection failed";

        }
      }

      async function createEscrow() {

        try {

          const seller =
            document.getElementById(
              "seller"
            ).value;

          const amount =
            document.getElementById(
              "amount"
            ).value;

          const parsedAmount =
            ethers.utils.parseUnits(
              amount,
              6
            );

          status.innerHTML =
            "Creating escrow...";

          const tx =
            await escrowContract.createEscrow(

              seller,

              parsedAmount

            );

          await tx.wait();

          status.innerHTML =
            "Escrow created successfully!";

        } catch (err) {

          console.error(err);

          status.innerHTML =
            "Escrow creation failed";

        }
      }

      async function approveUSDC() {

        try {

          const amount =
            document.getElementById(
              "amount"
            ).value;

          const parsedAmount =
            ethers.utils.parseUnits(
              amount,
              6
            );

          status.innerHTML =
            "Approving USDC...";

          const tx =
            await usdcContract.approve(

              ESCROW_ADDRESS,

              parsedAmount

            );

          await tx.wait();

          status.innerHTML =
            "USDC approved successfully!";

        } catch (err) {

          console.error(err);

          status.innerHTML =
            "USDC approval failed";

        }
      }

      async function depositUSDC() {

        try {

          const escrowId =
            document.getElementById(
              "escrowId"
            ).value;

          status.innerHTML =
            "Depositing USDC...";

          const tx =
            await escrowContract.deposit(
              escrowId
            );

          await tx.wait();

          status.innerHTML =
            "Funds locked in escrow!";

        } catch (err) {

          console.error(err);

          status.innerHTML =
            "Deposit failed";

        }
      }

      document
        .getElementById("connectBtn")
        .addEventListener(
          "click",
          connectWallet
        );

      document
        .getElementById("createBtn")
        .addEventListener(
          "click",
          createEscrow
        );

      document
        .getElementById("approveBtn")
        .addEventListener(
          "click",
          approveUSDC
        );

      document
        .getElementById("depositBtn")
        .addEventListener(
          "click",
          depositUSDC
        );

    </script>

  </body>
</html>
