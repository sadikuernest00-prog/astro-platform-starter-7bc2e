---
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>AmicBridge Escrow</title>

    <script type="module">
      import { ethers } from "https://cdn.jsdelivr.net/npm/ethers@6.13.1/+esm";

      // YOUR DEPLOYED ESCROW CONTRACT
      const ESCROW_ADDRESS =
        "0x7B6eB10420CdA9Dfcc04AE4964709E19857e7573";

      // BASE MAINNET USDC
      const USDC_ADDRESS =
        "0x833589fCD6EDB6E08f4c7C32D4f71b54bdA02913";

      // ESCROW ABI
      const escrowABI = [
        "function createEscrow(address seller,uint256 amount) external returns (uint256)",
        "function deposit(uint256 escrowId) external",
        "function releaseFunds(uint256 escrowId) external",
        "function refundBuyer(uint256 escrowId) external",
        "function escrowCount() view returns (uint256)"
      ];

      let provider;
      let signer;
      let escrowContract;

      // CONNECT WALLET
      async function connectWallet() {
        try {

          if (!window.ethereum) {
            alert("Install MetaMask");
            return;
          }

          provider = new ethers.BrowserProvider(window.ethereum);

          await provider.send("eth_requestAccounts", []);

          signer = await provider.getSigner();

          escrowContract = new ethers.Contract(
            ESCROW_ADDRESS,
            escrowABI,
            signer
          );

          const address = await signer.getAddress();

          document.getElementById("status").innerText =
            "Connected: " + address;

        } catch (err) {

          console.error(err);

          document.getElementById("status").innerText =
            "Wallet connection failed";
        }
      }

      // CREATE ESCROW
      async function createEscrow() {
        try {

          const seller =
            document.getElementById("seller").value;

          const amount =
            document.getElementById("amount").value;

          const parsedAmount =
            ethers.parseUnits(amount, 6);

          const tx =
            await escrowContract.createEscrow(
              seller,
              parsedAmount
            );

          document.getElementById("status").innerText =
            "Creating escrow...";

          await tx.wait();

          const escrowId =
            await escrowContract.escrowCount();

          document.getElementById("escrowId").value =
            escrowId;

          document.getElementById("status").innerText =
            "Escrow created successfully";

        } catch (err) {

          console.error(err);

          document.getElementById("status").innerText =
            "Escrow creation failed";

          alert(err.reason || err.message);
        }
      }

      // APPROVE USDC
      async function approveUSDC() {
        try {

          if (!signer) {
            alert("Connect wallet first");
            return;
          }

          const amount =
            document.getElementById("amount").value;

          const parsedAmount =
            ethers.parseUnits(amount, 6);

          const usdcContract = new ethers.Contract(
            USDC_ADDRESS,
            [
              "function approve(address spender,uint256 amount) external returns (bool)"
            ],
            signer
          );

          document.getElementById("status").innerText =
            "Waiting for approval...";

          const tx = await usdcContract.approve(
            ESCROW_ADDRESS,
            parsedAmount
          );

          await tx.wait();

          document.getElementById("status").innerText =
            "USDC approved successfully";

        } catch (err) {

          console.error(err);

          document.getElementById("status").innerText =
            "USDC approval failed";

          alert(err.reason || err.message);
        }
      }

      // DEPOSIT USDC
      async function depositUSDC() {
        try {

          const escrowId =
            document.getElementById("escrowId").value;

          const tx =
            await escrowContract.deposit(
              escrowId
            );

          document.getElementById("status").innerText =
            "Depositing USDC...";

          await tx.wait();

          document.getElementById("status").innerText =
            "USDC deposited successfully";

        } catch (err) {

          console.error(err);

          document.getElementById("status").innerText =
            "Deposit failed";

          alert(err.reason || err.message);
        }
      }

      // RELEASE FUNDS
      async function releaseFunds() {
        try {

          const escrowId =
            document.getElementById("escrowId").value;

          const tx =
            await escrowContract.releaseFunds(
              escrowId
            );

          document.getElementById("status").innerText =
            "Releasing funds...";

          await tx.wait();

          document.getElementById("status").innerText =
            "Funds released successfully";

        } catch (err) {

          console.error(err);

          document.getElementById("status").innerText =
            "Release failed";

          alert(err.reason || err.message);
        }
      }

      // REFUND BUYER
      async function refundBuyer() {
        try {

          const escrowId =
            document.getElementById("escrowId").value;

          const tx =
            await escrowContract.refundBuyer(
              escrowId
            );

          document.getElementById("status").innerText =
            "Refunding buyer...";

          await tx.wait();

          document.getElementById("status").innerText =
            "Buyer refunded successfully";

        } catch (err) {

          console.error(err);

          document.getElementById("status").innerText =
            "Refund failed";

          alert(err.reason || err.message);
        }
      }

      window.connectWallet = connectWallet;
      window.createEscrow = createEscrow;
      window.approveUSDC = approveUSDC;
      window.depositUSDC = depositUSDC;
      window.releaseFunds = releaseFunds;
      window.refundBuyer = refundBuyer;
    </script>

    <style>
      body {
        background: black;
        color: white;
        font-family: Arial, sans-serif;
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: 100vh;
        margin: 0;
      }

      .container {
        width: 700px;
        text-align: center;
      }

      h1 {
        font-size: 72px;
        color: #d4a84f;
        margin-bottom: 10px;
      }

      p {
        color: #999;
        font-size: 20px;
        margin-bottom: 40px;
      }

      input {
        width: 100%;
        padding: 24px;
        margin-bottom: 20px;
        border-radius: 20px;
        border: 1px solid #333;
        background: black;
        color: white;
        font-size: 28px;
        box-sizing: border-box;
      }

      .buttons {
        display: flex;
        flex-wrap: wrap;
        gap: 20px;
        justify-content: center;
      }

      button {
        padding: 22px 36px;
        border-radius: 20px;
        border: none;
        font-size: 22px;
        font-weight: bold;
        cursor: pointer;
        min-width: 240px;
      }

      .gold {
        background: #d4a84f;
        color: black;
      }

      .dark {
        background: #111;
        color: white;
        border: 1px solid #333;
      }

      .green {
        background: #22c55e;
        color: white;
      }

      .red {
        background: #ef4444;
        color: white;
      }

      #status {
        margin-top: 40px;
        font-size: 30px;
        font-weight: bold;
        color: #00ffae;
      }
    </style>
  </head>

  <body>
    <div class="container">

      <h1>International Trade</h1>

      <p>
        AmicBridge provides blockchain escrow infrastructure powered by USDC,
        smart contracts and decentralized settlement technology.
      </p>

      <input
        id="seller"
        type="text"
        placeholder="Seller Wallet Address"
      />

      <input
        id="amount"
        type="text"
        placeholder="Amount in USDC"
      />

      <input
        id="escrowId"
        type="text"
        placeholder="Escrow ID"
      />

      <div class="buttons">

        <button
          class="gold"
          onclick="connectWallet()"
        >
          Connect MetaMask
        </button>

        <button
          class="dark"
          onclick="createEscrow()"
        >
          Create Escrow
        </button>

        <button
          class="dark"
          onclick="approveUSDC()"
        >
          Approve USDC
        </button>

        <button
          class="dark"
          onclick="depositUSDC()"
        >
          Deposit USDC
        </button>

        <button
          class="green"
          onclick="releaseFunds()"
        >
          Release Funds
        </button>

        <button
          class="red"
          onclick="refundBuyer()"
        >
          Refund Buyer
        </button>

      </div>

      <div id="status"></div>

    </div>
  </body>
</html>
