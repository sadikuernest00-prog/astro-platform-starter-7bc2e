---
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <title>AmicBridge Escrow</title>

    <style>

      body {
        margin: 0;
        background: black;
        color: white;
        font-family: Arial, sans-serif;
      }

      .container {
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: 40px;
      }

      h1 {
        font-size: 72px;
        text-align: center;
        line-height: 1;
        max-width: 1000px;
      }

      .gold {
        color: #d4a24c;
      }

      p {
        color: #888;
        text-align: center;
        max-width: 800px;
        font-size: 22px;
        line-height: 1.5;
      }

      .form {
        display: flex;
        flex-direction: column;
        gap: 20px;
        margin-top: 40px;
      }

      input {
        width: 360px;
        padding: 18px;
        border-radius: 14px;
        border: 1px solid #333;
        background: #111;
        color: white;
        font-size: 16px;
      }

      .buttons {
        display: flex;
        gap: 20px;
        margin-top: 40px;
        flex-wrap: wrap;
        justify-content: center;
      }

      button {
        padding: 18px 30px;
        border-radius: 16px;
        border: 1px solid #333;
        background: #111;
        color: white;
        font-size: 20px;
        cursor: pointer;
      }

      .primary {
        background: #d4a24c;
        color: black;
        font-weight: bold;
      }

      .green {
        background: #00aa66;
      }

      .red {
        background: #cc3333;
      }

      .status {
        margin-top: 40px;
        color: #00ff99;
        font-size: 22px;
      }

      .escrow-list {
        margin-top: 60px;
        width: 100%;
        max-width: 700px;
      }

      .escrow-card {
        background: #111;
        border: 1px solid #333;
        border-radius: 18px;
        padding: 24px;
        margin-bottom: 20px;
      }

    </style>
  </head>

  <body>

    <div class="container">

      <h1>
        Secure Escrow Infrastructure
        <span class="gold">
          For International Trade
        </span>
      </h1>

      <p>
        AmicBridge provides blockchain escrow
        infrastructure powered by USDC,
        smart contracts and decentralized
        settlement technology.
      </p>

      <div class="form">

        <input
          id="seller"
          placeholder="Seller wallet address"
        />

        <input
          id="amount"
          placeholder="Amount in USDC"
        />

        <input
          id="escrowId"
          placeholder="Escrow Number (1,2,3...)"
        />

      </div>

      <div class="buttons">

        <button
          id="connectBtn"
          class="primary"
        >
          Connect MetaMask
        </button>

        <button id="createBtn">
          Create Escrow
        </button>

        <button id="approveBtn">
          Approve USDC
        </button>

        <button id="depositBtn">
          Deposit USDC
        </button>

        <button
          id="releaseBtn"
          class="green"
        >
          Release Funds
        </button>

        <button
          id="refundBtn"
          class="red"
        >
          Refund Buyer
        </button>

      </div>

      <div
        id="status"
        class="status"
      >
        Waiting for wallet connection...
      </div>

      <div class="escrow-list">

        <h2>
          Active Escrows
        </h2>

        <div id="escrowContainer">

        </div>

      </div>

    </div>

    <script is:inline type="module">

      import {
        ethers
      } from "https://cdn.jsdelivr.net/npm/ethers@5.7.2/dist/ethers.esm.min.js";

      // YOUR NEW DEPLOYED CONTRACT
      const ESCROW_ADDRESS =
        "0x885e28B0fCCdB5BBFE54DBfB20aF31AbDb64E81";

      // BASE SEPOLIA USDC
      const USDC_ADDRESS =
        "0x036CbD53842c5426634e7929541eC2318f3dCF7";

      const ESCROW_ABI = [

        "function createEscrow(address _seller,uint256 _amount,string memory _escrowReference) external",

        "function depositFunds(uint256 _escrowId) external",

        "function releaseFunds(uint256 _escrowId) external",

        "function refundBuyer(uint256 _escrowId) external",

        "function escrowCount() view returns (uint256)",

        "function getEscrow(uint256 _escrowId) view returns (uint256,address,address,uint256,string,uint8)"

      ];

      const USDC_ABI = [

        "function approve(address spender,uint256 amount) public returns (bool)"

      ];

      let provider;
      let signer;
      let escrowContract;
      let usdcContract;

      let escrows = [];

      const status =
        document.getElementById("status");

      const escrowContainer =
        document.getElementById(
          "escrowContainer"
        );

      function renderEscrows() {

        escrowContainer.innerHTML = "";

        escrows.forEach((escrow) => {

          escrowContainer.innerHTML += `
            <div class="escrow-card">

              <h3>
                Escrow #${escrow.id}
              </h3>

              <p>
                Seller: ${escrow.seller}
              </p>

              <p>
                Amount: ${escrow.amount} USDC
              </p>

              <p>
                Status: ${escrow.status}
              </p>

            </div>
          `;
        });
      }

      async function loadEscrows() {

        try {

          const total =
            await escrowContract.escrowCount();

          escrows = [];

          for (
            let i = 1;
            i <= total;
            i++
          ) {

            const escrow =
              await escrowContract.getEscrow(i);

            let stateText =
              "UNKNOWN";

            if (escrow[5] == 0)
              stateText =
                "AWAITING PAYMENT";

            if (escrow[5] == 1)
              stateText =
                "FUNDED";

            if (escrow[5] == 2)
              stateText =
                "RELEASED";

            if (escrow[5] == 3)
              stateText =
                "REFUNDED";

            if (escrow[5] == 4)
              stateText =
                "DISPUTED";

            escrows.push({

              id:
                escrow[0].toString(),

              seller:
                escrow[2],

              amount:
                ethers.utils.formatUnits(
                  escrow[3],
                  6
                ),

              status:
                stateText

            });
          }

          renderEscrows();

        } catch (err) {

          console.error(err);

        }
      }

      async function connectWallet() {

        try {

          if (!window.ethereum) {

            alert(
              "Install MetaMask"
            );

            return;
          }

          await window.ethereum.request({

            method:
              "eth_requestAccounts"

          });

          provider =
            new ethers.providers.Web3Provider(
              window.ethereum
            );

          signer =
            provider.getSigner();

          const network =
            await provider.getNetwork();

          if (network.chainId !== 84532) {

            status.innerHTML =
              "Switch MetaMask to Base Sepolia";

            return;
          }

          escrowContract =
            new ethers.Contract(

              ESCROW_ADDRESS,

              ESCROW_ABI,

              signer

            );

          usdcContract =
            new ethers.Contract(

              USDC_ADDRESS,

              USDC_ABI,

              signer

            );

          const address =
            await signer.getAddress();

          status.innerHTML =
            "Connected: " + address;

          await loadEscrows();

        } catch (err) {

          console.error(err);

          status.innerHTML =
            "Wallet connection failed";

        }
      }

      async function createEscrow() {

        try {

          const seller =
            document.getElementById(
              "seller"
            ).value;

          const amount =
            document.getElementById(
              "amount"
            ).value;

          const escrowReference =
            document.getElementById(
              "escrowId"
            ).value;

          const parsedAmount =
            ethers.utils.parseUnits(
              amount,
              6
            );

          status.innerHTML =
            "Creating escrow...";

          const tx =
            await escrowContract.createEscrow(

              seller,

              parsedAmount,

              escrowReference

            );

          await tx.wait();

          await loadEscrows();

          status.innerHTML =
            "Escrow created successfully!";

        } catch (err) {

          console.error(err);

          status.innerHTML =
            "Escrow creation failed";

        }
      }

      async function approveUSDC() {

        try {

          const amount =
            document.getElementById(
              "amount"
            ).value;

          const parsedAmount =
            ethers.utils.parseUnits(
              amount,
              6
            );

          status.innerHTML =
            "Approving USDC...";

          const tx =
            await usdcContract.approve(

              ESCROW_ADDRESS,

              parsedAmount

            );

          await tx.wait();

          status.innerHTML =
            "USDC approved successfully!";

        } catch (err) {

          console.error(err);

          status.innerHTML =
            "USDC approval failed";

        }
      }

      async function depositUSDC() {

        try {

          const escrowId =
            Number(
              document.getElementById(
                "escrowId"
              ).value
            );

          status.innerHTML =
            "Depositing USDC...";

          const tx =
            await escrowContract.depositFunds(
              escrowId
            );

          await tx.wait();

          await loadEscrows();

          status.innerHTML =
            "Funds locked in escrow!";

        } catch (err) {

          console.error(err);

          status.innerHTML =
            "Deposit failed";

        }
      }

      async function releaseFunds() {

        try {

          const escrowId =
            Number(
              document.getElementById(
                "escrowId"
              ).value
            );

          status.innerHTML =
            "Releasing funds...";

          const tx =
            await escrowContract.releaseFunds(
              escrowId
            );

          await tx.wait();

          await loadEscrows();

          status.innerHTML =
            "Funds released!";

        } catch (err) {

          console.error(err);

          status.innerHTML =
            "Release failed";

        }
      }

      async function refundBuyer() {

        try {

          const escrowId =
            Number(
              document.getElementById(
                "escrowId"
              ).value
            );

          status.innerHTML =
            "Refunding buyer...";

          const tx =
            await escrowContract.refundBuyer(
              escrowId
            );

          await tx.wait();

          await loadEscrows();

          status.innerHTML =
            "Buyer refunded!";

        } catch (err) {

          console.error(err);

          status.innerHTML =
            "Refund failed";

        }
      }

      document
        .getElementById("connectBtn")
        .addEventListener(
          "click",
          connectWallet
        );

      document
        .getElementById("createBtn")
        .addEventListener(
          "click",
          createEscrow
        );

      document
        .getElementById("approveBtn")
        .addEventListener(
          "click",
          approveUSDC
        );

      document
        .getElementById("depositBtn")
        .addEventListener(
          "click",
          depositUSDC
        );

      document
        .getElementById("releaseBtn")
        .addEventListener(
          "click",
          releaseFunds
        );

      document
        .getElementById("refundBtn")
        .addEventListener(
          "click",
          refundBuyer
        );

    </script>

  </body>
</html>
