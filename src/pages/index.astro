---
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <title>AmicBridge Escrow</title>

    <style>

      body {
        margin: 0;
        background: black;
        color: white;
        font-family: Arial, sans-serif;
      }

      .container {
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        padding: 40px;
      }

      .badge {
        border: 1px solid #333;
        padding: 10px 20px;
        border-radius: 999px;
        color: #d4a24c;
        margin-bottom: 40px;
      }

      h1 {
        font-size: 82px;
        text-align: center;
        line-height: 1;
        margin: 0;
        max-width: 1000px;
      }

      .gold {
        color: #d4a24c;
      }

      p {
        margin-top: 40px;
        max-width: 800px;
        text-align: center;
        color: #888;
        font-size: 22px;
        line-height: 1.6;
      }

      .form {
        margin-top: 50px;
        display: flex;
        flex-direction: column;
        gap: 20px;
      }

      input {
        width: 360px;
        padding: 18px;
        border-radius: 14px;
        border: 1px solid #333;
        background: #111;
        color: white;
        font-size: 16px;
      }

      .buttons {
        margin-top: 40px;
        display: flex;
        gap: 20px;
        flex-wrap: wrap;
        justify-content: center;
      }

      button {
        padding: 20px 35px;
        border-radius: 18px;
        border: 1px solid #333;
        background: #111;
        color: white;
        font-size: 22px;
        cursor: pointer;
        transition: 0.2s;
      }

      button:hover {
        opacity: 0.8;
      }

      .primary {
        background: #d4a24c;
        color: black;
        font-weight: bold;
      }

      .status {
        margin-top: 40px;
        color: #00ff99;
        font-size: 22px;
      }

      @media(max-width:900px){

        h1{
          font-size:56px;
        }

        input{
          width:100%;
        }

      }

    </style>
  </head>

  <body>

    <div class="container">

      <div class="badge">
        GLOBAL CRYPTO COMMODITY INFRASTRUCTURE
      </div>

      <h1>
        Secure Escrow Infrastructure
        <span class="gold">
          For International Trade
        </span>
      </h1>

      <p>
        AmicBridge provides blockchain escrow
        infrastructure powered by USDC,
        smart contracts and decentralized
        settlement technology.
      </p>

      <div class="form">

        <input
          id="seller"
          placeholder="Seller wallet address"
        />

        <input
          id="amount"
          placeholder="Amount in USDC"
        />

      </div>

      <div class="buttons">

        <button
          id="connectBtn"
          class="primary"
        >
          Connect MetaMask
        </button>

        <button id="createBtn">
          Create Escrow
        </button>

      </div>

      <div
        id="status"
        class="status"
      >
        Waiting for wallet connection...
      </div>

    </div>

    <script is:inline type="module">

      import {
        ethers
      } from "https://cdn.jsdelivr.net/npm/ethers@5.7.2/dist/ethers.esm.min.js";

      const CONTRACT_ADDRESS =
        "0xABD89d64ece71a87C6F3d20DE038930D8f99B02E";

      const CONTRACT_ABI = [

        "function createEscrow(address seller,uint256 amount)"

      ];

      let provider;
      let signer;
      let contract;

      const status =
        document.getElementById("status");

      async function connectWallet() {

        try {

          if (!window.ethereum) {

            alert(
              "MetaMask is not installed"
            );

            return;
          }

          await window.ethereum.request({

            method:
              "eth_requestAccounts"

          });

          provider =
            new ethers.providers.Web3Provider(
              window.ethereum
            );

          signer =
            provider.getSigner();

          contract =
            new ethers.Contract(

              CONTRACT_ADDRESS,

              CONTRACT_ABI,

              signer

            );

          const address =
            await signer.getAddress();

          status.innerHTML =
            "Connected: " + address;

        } catch (err) {

          console.error(err);

          status.innerHTML =
            "Wallet connection failed";

        }
      }

      async function createEscrow() {

        try {

          if (!contract) {

            alert(
              "Connect MetaMask first"
            );

            return;
          }

          const seller =
            document.getElementById(
              "seller"
            ).value;

          const amount =
            document.getElementById(
              "amount"
            ).value;

          if (!seller || !amount) {

            alert(
              "Fill all fields"
            );

            return;
          }

          const parsedAmount =
            ethers.utils.parseUnits(
              amount,
              6
            );

          status.innerHTML =
            "Creating escrow...";

          const tx =
            await contract.createEscrow(

              seller,

              parsedAmount

            );

          status.innerHTML =
            "Waiting for confirmation...";

          await tx.wait();

          status.innerHTML =
            "Escrow created successfully!";

        } catch (err) {

          console.error(err);

          status.innerHTML =
            "Transaction failed";

        }
      }

      document
        .getElementById("connectBtn")
        .addEventListener(
          "click",
          connectWallet
        );

      document
        .getElementById("createBtn")
        .addEventListener(
          "click",
          createEscrow
        );

    </script>

  </body>
</html>
