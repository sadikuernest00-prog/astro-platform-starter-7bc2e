---
import Layout from "../layouts/Layout.astro";
---

<Layout title="AmicBridge Escrow">

  <main class="container">

    <h1>AmicBridge Escrow</h1>

    <p>
      Secure crypto escrow payments on Base network.
    </p>

    <button id="connectButton">
      Connect MetaMask
    </button>

    <button id="depositButton">
      Deposit ETH
    </button>

    <button id="releaseButton">
      Release Funds
    </button>

    <p id="status"></p>

  </main>

</Layout>

<script type="module">

import { ethers } from "ethers";
import { contractAddress, abi } from "../lib/contract.js";

const connectButton = document.getElementById("connectButton");
const depositButton = document.getElementById("depositButton");
const releaseButton = document.getElementById("releaseButton");
const status = document.getElementById("status");

let signer;
let contract;

async function connectWallet() {

  if (!window.ethereum) {
    alert("Please install MetaMask");
    return;
  }

  await window.ethereum.request({
    method: "eth_requestAccounts"
  });

  const provider = new ethers.BrowserProvider(window.ethereum);

  signer = await provider.getSigner();

  contract = new ethers.Contract(
    contractAddress,
    abi,
    signer
  );

  status.innerText = "Wallet Connected";
}

async function depositETH() {

  if (!contract) {
    alert("Connect wallet first");
    return;
  }

  try {

    const tx = await contract.deposit({
      value: ethers.parseEther("0.01")
    });

    status.innerText = "Depositing ETH...";

    await tx.wait();

    status.innerText = "Deposit Successful";

  } catch (error) {

    console.error(error);

    status.innerText = "Deposit Failed";
  }
}

async function releaseFunds() {

  if (!contract) {
    alert("Connect wallet first");
    return;
  }

  try {

    const tx = await contract.releaseFunds();

    status.innerText = "Releasing Funds...";

    await tx.wait();

    status.innerText = "Funds Released";

  } catch (error) {

    console.error(error);

    status.innerText = "Release Failed";
  }
}

connectButton.addEventListener(
  "click",
  connectWallet
);

depositButton.addEventListener(
  "click",
  depositETH
);

releaseButton.addEventListener(
  "click",
  releaseFunds
);

</script>

<style>

.container {

  max-width: 700px;
  margin: 100px auto;
  text-align: center;
  font-family: Arial;
}

h1 {

  font-size: 48px;
  margin-bottom: 20px;
}

p {

  margin-bottom: 30px;
}

button {

  padding: 15px 25px;
  margin: 10px;
  border: none;
  border-radius: 10px;
  cursor: pointer;
  font-size: 16px;
}

#connectButton {

  background: black;
  color: white;
}

#depositButton {

  background: green;
  color: white;
}

#releaseButton {

  background: blue;
  color: white;
}

#status {

  margin-top: 30px;
  font-size: 18px;
}

</style>
