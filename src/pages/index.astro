<html>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>AmicBridge Payment</title>

    <script type="module">

      import { ethers } from "https://cdn.jsdelivr.net/npm/ethers@6.13.1/+esm";

      const ESCROW_ADDRESS =
        "0x6adc89086B4443bE25DaB92c76eE85d0ee36c6c";

      const USDC_ADDRESS =
        "0x833589fcd6edb6e08f4c7c32d4f71b54bda02913";

      const escrowABI = [
        "function deposit(uint256 escrowId) external",
        "function getEscrow(uint256 escrowId) view returns ((uint256 id,address buyer,address seller,uint256 amount,uint256 releaseTime,uint8 status,bool deposited,bool disputed))"
      ];

      const params =
        new URLSearchParams(window.location.search);

      const escrowId =
        params.get("escrow");

      let provider;
      let signer;
      let escrowContract;

      async function connectWallet() {

        provider =
          new ethers.BrowserProvider(
            window.ethereum
          );

        await provider.send(
          "eth_requestAccounts",
          []
        );

        signer =
          await provider.getSigner();

        escrowContract =
          new ethers.Contract(
            ESCROW_ADDRESS,
            escrowABI,
            signer
          );

        document.getElementById(
          "status"
        ).innerText =
          "Wallet connected";
      }

      async function approveUSDC() {

        const escrow =
          await escrowContract.getEscrow(
            escrowId
          );

        const usdcContract =
          new ethers.Contract(
            USDC_ADDRESS,
            [
              "function approve(address spender,uint256 amount) external returns (bool)"
            ],
            signer
          );

        const tx =
          await usdcContract.approve(
            ESCROW_ADDRESS,
            escrow.amount
          );

        await tx.wait();

        document.getElementById(
          "status"
        ).innerText =
          "USDC approved";
      }

      async function depositUSDC() {

        const tx =
          await escrowContract.deposit(
            escrowId
          );

        await tx.wait();

        document.getElementById(
          "status"
        ).innerText =
          "Funds locked in escrow";
      }

      async function loadEscrow() {

        provider =
          new ethers.BrowserProvider(
            window.ethereum
          );

        escrowContract =
          new ethers.Contract(
            ESCROW_ADDRESS,
            escrowABI,
            provider
          );

        const escrow =
          await escrowContract.getEscrow(
            escrowId
          );

        document.getElementById(
          "escrow"
        ).innerHTML = `

          <div class="card">

            <h2>
              Escrow Payment
            </h2>

            <p>
              Escrow #${escrow.id}
            </p>

            <p>
              ${ethers.formatUnits(
                escrow.amount,
                6
              )} USDC
            </p>

            <p>
              Seller:
              ${escrow.seller}
            </p>

          </div>

        `;
      }

      window.connectWallet = connectWallet;
      window.approveUSDC = approveUSDC;
      window.depositUSDC = depositUSDC;

      window.onload = () => {
        loadEscrow();
      };

    </script>

    <style>

      body {
        background: black;
        color: white;
        font-family: Arial;
        padding: 40px;
      }

      .container {
        max-width: 700px;
        margin: auto;
      }

      h1 {
        color: #d4a84f;
        text-align: center;
        font-size: 60px;
      }

      .card {
        background: #111;
        border-radius: 22px;
        padding: 30px;
        margin-top: 30px;
        border: 1px solid #333;
      }

      .buttons {
        display: grid;
        gap: 18px;
        margin-top: 30px;
      }

      button {
        padding: 22px;
        border-radius: 18px;
        border: none;
        font-size: 18px;
        font-weight: bold;
        cursor: pointer;
      }

      .gold {
        background: #d4a84f;
        color: black;
      }

      .dark {
        background: #111;
        color: white;
        border: 1px solid #333;
      }

      #status {
        margin-top: 25px;
        color: #00ffae;
        text-align: center;
        font-size: 22px;
      }

    </style>

  </head>

  <body>

    <div class="container">

      <h1>
        AmicBridge
      </h1>

      <div id="escrow"></div>

      <div class="buttons">

        <button
          class="gold"
          onclick="connectWallet()"
        >
          Connect Wallet
        </button>

        <button
          class="dark"
          onclick="approveUSDC()"
        >
          Approve USDC
        </button>

        <button
          class="dark"
          onclick="depositUSDC()"
        >
          Deposit USDC
        </button>

      </div>

      <div id="status"></div>

    </div>

  </body>
</html>
