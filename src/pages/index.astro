---
---

<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>AmicBridge Escrow</title>

  <style>
    body {
      margin: 0;
      background: black;
      color: white;
      font-family: Arial, sans-serif;
      text-align: center;
    }

    .container {
      width: 100%;
      max-width: 900px;
      margin: auto;
      padding-top: 40px;
    }

    h1 {
      font-size: 90px;
      line-height: 1;
      margin-bottom: 30px;
      font-weight: 900;
    }

    .gold {
      color: #d6a84f;
    }

    p {
      color: gray;
      font-size: 20px;
      margin-bottom: 50px;
      line-height: 1.5;
    }

    input {
      width: 100%;
      max-width: 500px;
      height: 70px;
      border-radius: 20px;
      border: 2px solid #222;
      background: #080808;
      color: white;
      font-size: 18px;
      padding-left: 25px;
      margin-bottom: 25px;
    }

    .buttons {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 20px;
      margin-top: 20px;
    }

    button {
      border: none;
      border-radius: 22px;
      padding: 24px 40px;
      font-size: 22px;
      font-weight: bold;
      cursor: pointer;
      color: white;
      background: #0d0d0d;
      border: 2px solid #1d1d1d;
    }

    .connect {
      background: #d6a84f;
      color: black;
    }

    .release {
      background: #19cc6f;
    }

    .refund {
      background: #ef3737;
    }

    .status {
      margin-top: 35px;
      color: #00ffae;
      font-size: 24px;
      font-weight: bold;
    }

    .escrow-box {
      margin-top: 70px;
      text-align: left;
    }

    .escrow-box h2 {
      font-size: 72px;
      margin-bottom: 20px;
    }

    .escrow-card {
      margin-top: 30px;
    }

    .escrow-card h3 {
      font-size: 60px;
      margin-bottom: 20px;
    }

    .escrow-card p {
      color: white;
      font-size: 30px;
      margin: 20px 0;
    }
  </style>
</head>

<body>

<div class="container">

  <h1>
    Secure Escrow <br />
    Infrastructure <span class="gold">For</span> <br />
    <span class="gold">International Trade</span>
  </h1>

  <p>
    AmicBridge provides blockchain escrow infrastructure powered by USDC,
    smart contracts and decentralized settlement technology.
  </p>

  <input
    id="seller"
    placeholder="Seller wallet address"
  />

  <br />

  <input
    id="amount"
    placeholder="Amount in USDC"
  />

  <br />

  <input
    id="escrowId"
    placeholder="Escrow Number (1,2,3...)"
  />

  <div class="buttons">

    <button
      class="connect"
      onclick="connectWallet()"
    >
      Connect MetaMask
    </button>

    <button onclick="createEscrow()">
      Create Escrow
    </button>

    <button onclick="approveUSDC()">
      Approve USDC
    </button>

    <button onclick="depositUSDC()">
      Deposit USDC
    </button>

    <button
      class="release"
      onclick="releaseFunds()"
    >
      Release Funds
    </button>

    <button
      class="refund"
      onclick="refundBuyer()"
    >
      Refund Buyer
    </button>

  </div>

  <div id="status" class="status">
    Waiting for wallet connection...
  </div>

  <div class="escrow-box">

    <h2>Active Escrows</h2>

    <div class="escrow-card">

      <h3 id="escrowTitle">
        Escrow #0
      </h3>

      <p id="sellerText">
        Seller:
      </p>

      <p id="amountText">
        Amount:
      </p>

      <p id="statusText">
        Status:
      </p>

    </div>

  </div>

</div>

<script type="module">

import { ethers } from "https://cdn.jsdelivr.net/npm/ethers@6.13.1/+esm";

const ESCROW_ADDRESS =
"0x7B6eB10420CdA9Dfcc04AE4964709E19857e7573";

const USDC_ADDRESS =
"0x833589fCD6EDB6E08f4c7C32D4f71b54bdA02913";

const ABI = [
  "function createEscrow(address seller,uint256 amount) external returns(uint256)",
  "function deposit(uint256 escrowId) external",
  "function releaseFunds(uint256 escrowId) external",
  "function refundBuyer(uint256 escrowId) external",
  "function getEscrow(uint256 escrowId) external view returns(tuple(uint256 id,address buyer,address seller,uint256 amount,bool deposited,bool released,bool refunded))"
];

const ERC20ABI = [
  "function approve(address spender,uint256 amount) external returns(bool)"
];

let provider;
let signer;
let escrow;
let usdc;

window.connectWallet = async () => {

  try {

    if (!window.ethereum) {
      alert("Install MetaMask");
      return;
    }

    await window.ethereum.request({
      method: "eth_requestAccounts",
    });

    provider = new ethers.BrowserProvider(window.ethereum);

    signer = await provider.getSigner();

    escrow = new ethers.Contract(
      ESCROW_ADDRESS,
      ABI,
      signer
    );

    usdc = new ethers.Contract(
      USDC_ADDRESS,
      ERC20ABI,
      signer
    );

    const address = await signer.getAddress();

    document.getElementById("status").innerHTML =
      "Connected: " + address;

  } catch (err) {

    console.log(err);

    document.getElementById("status").innerHTML =
      "Wallet connection failed";

  }
};

window.createEscrow = async () => {

  try {

    const seller =
      document.getElementById("seller").value;

    const amount =
      document.getElementById("amount").value;

    const tx =
      await escrow.createEscrow(
        seller,
        ethers.parseUnits(amount, 6)
      );

    await tx.wait();

    document.getElementById("status").innerHTML =
      "Escrow created successfully";

    const escrowId = 1;

    document.getElementById("escrowTitle").innerHTML =
      "Escrow #" + escrowId;

    document.getElementById("sellerText").innerHTML =
      "Seller: " + seller;

    document.getElementById("amountText").innerHTML =
      "Amount: " + amount + " USDC";

    document.getElementById("statusText").innerHTML =
      "Status: AWAITING PAYMENT";

  } catch (err) {

    console.log(err);

    document.getElementById("status").innerHTML =
      "Escrow creation failed";

  }
};

window.approveUSDC = async () => {

  try {

    const amount =
      document.getElementById("amount").value;

    const tx =
      await usdc.approve(
        ESCROW_ADDRESS,
        ethers.parseUnits(amount, 6)
      );

    await tx.wait();

    document.getElementById("status").innerHTML =
      "USDC approved successfully";

  } catch (err) {

    console.log(err);

    document.getElementById("status").innerHTML =
      "USDC approval failed";

  }
};

window.depositUSDC = async () => {

  try {

    const escrowId =
      document.getElementById("escrowId").value;

    const tx =
      await escrow.deposit(escrowId);

    await tx.wait();

    document.getElementById("status").innerHTML =
      "USDC deposited successfully";

    document.getElementById("statusText").innerHTML =
      "Status: FUNDED";

  } catch (err) {

    console.log(err);

    document.getElementById("status").innerHTML =
      "Deposit failed";

  }
};

window.releaseFunds = async () => {

  try {

    const escrowId =
      document.getElementById("escrowId").value;

    const tx =
      await escrow.releaseFunds(escrowId);

    await tx.wait();

    document.getElementById("status").innerHTML =
      "Funds released successfully";

    document.getElementById("statusText").innerHTML =
      "Status: RELEASED";

  } catch (err) {

    console.log(err);

    document.getElementById("status").innerHTML =
      "Release failed";

  }
};

window.refundBuyer = async () => {

  try {

    const escrowId =
      document.getElementById("escrowId").value;

    const tx =
      await escrow.refundBuyer(escrowId);

    await tx.wait();

    document.getElementById("status").innerHTML =
      "Buyer refunded successfully";

    document.getElementById("statusText").innerHTML =
      "Status: REFUNDED";

  } catch (err) {

    console.log(err);

    document.getElementById("status").innerHTML =
      "Refund failed";

  }
};

</script>

</body>
</html>
